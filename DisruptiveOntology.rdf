        <rdfs:label>Construction Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ConstructionWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Contraflow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Contraflow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
