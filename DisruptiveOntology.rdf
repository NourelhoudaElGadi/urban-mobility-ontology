    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ConvoyService">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>A convoy service is in operation. This concept and description are from the DATEX II concept convoyService.</rdfs:comment>
        <rdfs:label>Convoy Service</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ConvoyService</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CricketMatch -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CricketMatch">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
