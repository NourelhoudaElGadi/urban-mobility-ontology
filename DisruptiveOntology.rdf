        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Damaged vehicle(s) which may cause traffic disruption. This concept and description are a generalised version of the DATEX II concept damagedVehicle.</rdfs:comment>
        <rdfs:label>Damaged Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedVehicle</rdfs:seeAlso>
