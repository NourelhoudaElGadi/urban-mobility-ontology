    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DamagedViaduct">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to a viaduct that may cause traffic disruption. This concept and description are from the DATEX II concept damagedViaduct.</rdfs:comment>
