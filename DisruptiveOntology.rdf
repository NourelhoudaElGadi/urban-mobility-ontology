        <rdfs:comment>Damage to a bridge that may cause traffic disruption. This concept and description are from the DATEX II concept damagedBridge.</rdfs:comment>
        <rdfs:label>Damaged Bridge</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedBridge</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DamagedCrashBarrier -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DamagedCrashBarrier">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to a crash barrier that may cause traffic disruption. This concept and description are from the DATEX II concept damagedCrashBarrier.</rdfs:comment>
        <rdfs:label>Damaged Crash Barrier</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedCrashBarrier</rdfs:seeAlso>
    </owl:Class>
    


