    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CommercialEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Commercial event which could disrupt traffic. This concept and description are from the DATEX II concept commercialEvent.</rdfs:comment>
        <rdfs:label>Commercial Event</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CommercialEvent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Concert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Concert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Concert event that could disrupt traffic. This concept and description are from the DATEX II concept concert.</rdfs:comment>
        <rdfs:label>Concert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Concert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Conditions -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Conditions">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>Any conditions which have the potential to degrade normal driving conditions. This concept and description are from the DATEX II concept Conditions.</rdfs:comment>
        <rdfs:label>Conditions</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Conditions</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ConstructionWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ConstructionWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureConstruction"/>
