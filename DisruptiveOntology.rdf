    <!-- http://purl.org/td/transportdisruption#Demonstration -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Demonstration">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A public protest with the potential to disrupt traffic. This concept and description are from the DATEX II concept demonstration.</rdfs:comment>
        <rdfs:label>Demonstration</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Demonstration</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DenseFog -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DenseFog">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Dense fog, limiting visibility to 50m or less. This concept and description are from the DATEX II concept denseFog.</rdfs:comment>
        <rdfs:label>Dense Fog</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DenseFog</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Derailment -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Derailment">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleOffInfrastructure"/>
        <rdfs:comment>Includes all accidents where one or more vehicles have left the rails of a track.</rdfs:comment>
        <rdfs:label>Derailment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DieselOnInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DieselOnInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Diesel on transport infrastructure. This concept and description are a generalised version of the DATEX II concept dieselOnRoad.</rdfs:comment>
        <rdfs:label>Diesel On Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DieselOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DisruptiveEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DisruptiveEvent">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/td/transportdisruption#causeOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/td/transportdisruption#DisruptiveImpact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An event that has caused a disruptive impact.  This class is designed to allow events of any type to be typed as disruptive; as such, it is not hte intention that this class is extended further.</rdfs:comment>
        <rdfs:label>Disruptive Event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DisruptiveImpact -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DisruptiveImpact">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/td/transportdisruption#impactsOn"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/td/transportdisruption#Plan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/td/transportdisruption#relevantTo"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A disruptive impact the action of one or more events causing or tending to prevent an agent&apos;s planned travel from continuing as expected.</rdfs:comment>
        <rdfs:label>Disruptive Impact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DisturbanceActivity -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DisturbanceActivity">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Activity"/>
        <rdfs:comment>Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic. This concept and description are from the DATEX II concept DisturbanceActivity.</rdfs:comment>
        <rdfs:label>Disturbance Activity</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DisturbanceActivity</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DrivingCondition -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DrivingCondition">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Conditions"/>
        <rdfs:comment>Types of the perceived conditions affecting travel. This concept and description are from the DATEX II concept DrivingConditionTypeEnum.</rdfs:comment>
        <rdfs:label>Travel Conditions</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DrivingConditionTypeEnum</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Dry -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Dry">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>The infrastructure surface is dry. This concept and description are a generalised version of the DATEX II concept dry.</rdfs:comment>
        <rdfs:label>Dry</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Dry</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EarthquakeDamage -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EarthquakeDamage">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>The transport infrastructure obstructed or partially obstructed because of damage caused by an earthquake. This concept and description are a generalised version of the DATEX II concept earthquakeDamage.</rdfs:comment>
        <rdfs:label>Earthquake Damage</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EarthquakeDamage</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Eclipse -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Eclipse">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Eclipse, either partial or full, of the sun causing low light levels during normal daylight period. This concept and description are from the DATEX II concept eclipse.</rdfs:comment>
        <rdfs:label>Eclipse</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Eclipse</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EmergencyRoadsideTelephoneFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EmergencyRoadsideTelephoneFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of emergency roadside telephones. This concept and description are based on the DATEX II concept emergencyRoadsideTelephones.</rdfs:comment>
        <rdfs:label>Emergency Roadside Telephone Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EmergencyRoadsideTelephones</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EmergencyRoadsideTelephoneFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EmergencyRoadsideTelephoneFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning emergency roadside telephones. This concept and description are based on the DATEX II concept emergencyRoadsideTelephones.</rdfs:comment>
        <rdfs:label>Emergency Roadside Telephone Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EmergencyRoadsideTelephones</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EmergencyServices -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EmergencyServices">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Emergency services assistance. This concept and description are from the DATEX II concept emergencyServices.</rdfs:comment>
        <rdfs:label>Emergency Services</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EmergencyServices</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EmergencyVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EmergencyVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Emergency service vehicles on some transport infrastructure in response to an emergency situation. This concept and description are a generalised version of the DATEX II concept emergencyVehicle.</rdfs:comment>
        <rdfs:label>Emergency Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EmergencyVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EnvironmentalConditions -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EnvironmentalConditions">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Conditions"/>
        <rdfs:comment>Types of environmental conditions that may affect the transport network. This concept and description are based on the DATEX II concept PoorEnvironmentConditions</rdfs:comment>
        <rdfs:label>Environmental Conditions</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PoorEnvironmentTypeEnum</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#EnvironmentalObstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#EnvironmentalObstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Obstruction"/>
        <rdfs:comment>An obstruction on transport infrastructure resulting from an environmental cause. This concept and description are a generalised version of the DATEX II concept EnvironmentalObstruction.</rdfs:comment>
        <rdfs:label>Environmental Obstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EnvironmentalObstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Evacuation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Evacuation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where a definite area is being cleared due to dangerous conditions or for security reasons. This concept and description are from the DATEX II concept evacuation.</rdfs:comment>
        <rdfs:label>Evacuation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Evacuation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Exhibition -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Exhibition">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Major display or trade show which could disrupt traffic. This concept and description are from the DATEX II concept exhibition.</rdfs:comment>
        <rdfs:label>Exhibition</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Exhibition</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ExtremeCold -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ExtremeCold">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Abnormally low temperatures. This concept and description are from the DATEX II concept extremeCold.</rdfs:comment>
        <rdfs:label>Extreme Cold</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ExtremeCold</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ExtremeHeat -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ExtremeHeat">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Abnormally high expected maximum temperature. This concept and description are from the DATEX II concept extremeHeat.</rdfs:comment>
        <rdfs:label>Extreme Heat</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ExtremeHeat</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Fair -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Fair">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Periodic (e.g. annual), often traditional, gathering for entertainment or trade promotion, which could disrupt traffic. This concept and description are from the DATEX II concept fair.</rdfs:comment>
        <rdfs:label>Fair</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Fair</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FallenPowerCables -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FallenPowerCables">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Transport infrastructure is obstructed or partially obstructed by one or more fallen power cables. This concept and description are a generalised version of the DATEX II concept fallenPowerCables.</rdfs:comment>
        <rdfs:label>Fallen Power Cables</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FallenPowerCables</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FallenTrees -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FallenTrees">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>The transport infrastructure is obstructed or partially obstructed by one or more fallen trees. This concept and description are a generalised version of the DATEX II concept fallenTrees.</rdfs:comment>
        <rdfs:label>Fallen Trees</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FallenTrees</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FallingIce -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FallingIce">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Falling ice off trees, power lines or structures which may cause traffic disruption. This concept and description are from the DATEX II concept fallingIce.</rdfs:comment>
        <rdfs:label>Falling Ice</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FallingIce</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FallingLightIceOrSnow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FallingLightIceOrSnow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Falling light ice or snow off trees, power lines or structures which may cause traffic disruption. This concept and description are from the DATEX II concept fallingLightIceOrSnow.</rdfs:comment>
        <rdfs:label>Falling Light Ice Or Snow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FallingLightIceOrSnow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Festival -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Festival">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Celebratory event or series of events which could disrupt traffic. This concept and description are from the DATEX II concept festival.</rdfs:comment>
        <rdfs:label>Festival</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Festival</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FilmTVMaking -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FilmTVMaking">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Film or TV making event which could disrupt traffic. This concept and description are from the DATEX II concept filmTVMaking.</rdfs:comment>
        <rdfs:label>Film TV Making</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FilmTVMaking</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FilterBlockade -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FilterBlockade">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A manned blockade of some transport infrasturcture where only certain vehicles are allowed through. This concept and description are a generalised version of the DATEX II concept filterBlockade.</rdfs:comment>
        <rdfs:label>Filter Blockade</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FilterBlockade</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FirstAid -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FirstAid">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>First aid assistance. This concept and description are from the DATEX II concept firstAid.</rdfs:comment>
        <rdfs:label>First Aid</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FirstAid</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FlashFloods -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FlashFloods">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>The transport infrastructure being quickly inundated by powerful floodwaters due to heavy rain nearby. This concept and description are a generalised version of the DATEX II concept flashFloods.</rdfs:comment>
        <rdfs:label>Flash Floods</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FlashFloods</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Flooding -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Flooding">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>The transport infrastructure is obstructed or partially obstructed by flood water. This concept and description are a generalised version of the DATEX II concept flooding.</rdfs:comment>
        <rdfs:label>Flooding</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Flooding</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Fog -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Fog">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Fog, visibility more than 50m. This concept and description are from the DATEX II concept fog.</rdfs:comment>
        <rdfs:label>Fog</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Fog</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FoodDelivery -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FoodDelivery">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Food delivery. This concept and description are from the DATEX II concept foodDelivery.</rdfs:comment>
        <rdfs:label>Food Delivery</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FoodDelivery</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FootballMatch -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FootballMatch">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Football match that could disrupt traffic. This concept and description are from the DATEX II concept footballMatch.</rdfs:comment>
        <rdfs:label>Football Match</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FootballMatch</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ForestFire -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ForestFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to a forest fire adjacent to some transport infrastructure. This concept and description are a generalised version of the DATEX II concept forestFire.</rdfs:comment>
        <rdfs:label>Forest Fire</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ForestFire</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FreezingFog -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FreezingFog">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Fog, in conjunction with sub-zero air temperatures causing possible freezing of infrastructure such as road surface. This concept and description are a generalised version of the DATEX II concept freezingFog.</rdfs:comment>
        <rdfs:label>Freezing Fog</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FreezingFog</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FreezingOfWetInfrastructureSurface -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FreezingOfWetInfrastructureSurface">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>The wet infrastructure surface is subject to freezing. This concept and description are a generalised version of the DATEX II concept freezingOfWetRoads.</rdfs:comment>
        <rdfs:label>Freezing Of Wet Infrastructure Surface</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FreezingOfWetRoads</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FreezingPavements -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FreezingPavements">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>The pavements for pedestrians are subject to freezing. This concept and description are from the DATEX II concept freezingPavements.</rdfs:comment>
        <rdfs:label>Freezing Pavements</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FreezingPavements</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FreezingRain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FreezingRain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Falling rain on sub-zero temperature infrastructure surfaces freezing. This concept and description are a generalised version of the DATEX II concept freezingRain.</rdfs:comment>
        <rdfs:label>Freezing Rain</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FreezingRain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FreshSnow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FreshSnow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Fresh snow on the infrastructure. This concept and description are a generalised version of the DATEX II concept freshSnow.</rdfs:comment>
        <rdfs:label>Fresh Snow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FreshSnow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Frost -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Frost">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Frost. This concept and description are adaptations of the DATEX II concept frost.</rdfs:comment>
        <rdfs:label>Frost</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Frost</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#FuelSpillageAccident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#FuelSpillageAccident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#SpillageAccident"/>
        <rdfs:comment>Includes all situations resulting in a spillage of fuel. This concept and description are a generalised version of the DATEX II concept fuelSpillageAccident.</rdfs:comment>
        <rdfs:label>Fuel Spillage Accident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#FuelSpillageAccident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Funfair -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Funfair">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Periodic (e.g. annual), often traditional, gathering for entertainment, which could disrupt traffic. This concept and description are from the DATEX II concept funfair.</rdfs:comment>
        <rdfs:label>Funfair</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Funfair</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Gales -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Gales">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Winds between 60 km/h and 90 km/h. This concept and description are from the DATEX II concept gales.</rdfs:comment>
        <rdfs:label>Gales</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Gales</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GalleryLightsFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GalleryLightsFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of gallery lights. This concept and description are based on the DATEX II concept galleryLights.</rdfs:comment>
        <rdfs:label>Gallery Lights Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GalleryLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GalleryLightsFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GalleryLightsFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning gallery lights. This concept and description are based on the DATEX II concept galleryLights.</rdfs:comment>
        <rdfs:label>Gallery Lights Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GalleryLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GardeningOrFlowerShow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GardeningOrFlowerShow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Gardening and/or flower show or event which could disrupt traffic. This concept and description are from the DATEX II concept gardeningOrFlowerShow.</rdfs:comment>
        <rdfs:label>Gardening Or Flower Show</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GardeningOrFlowerShow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GasLeak -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GasLeak">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to an explosion hazard from gas escaping in or near transport infrastructure. This concept and description are a generalised version of the DATEX II concept gasLeak.</rdfs:comment>
        <rdfs:label>Gas Leak</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GasLeak</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GeneralNetworkManagement -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GeneralNetworkManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#NetworkManagement"/>
        <rdfs:comment>Network management action that is instigated either manually or automatically by the network operator.  Compliance with any resulting control may be advisory or mandatory. This concept and description are a generalised version the DATEX II concept GeneralNetworkManagement.</rdfs:comment>
        <rdfs:label>General Network Management</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GeneralNetworkManagement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GeneralObstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GeneralObstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Obstruction"/>
        <rdfs:comment>Any stationary or moving obstacle of a physical nature, other than of an animal, vehicle, environmental, or damaged equipment nature. This concept and description are from the DATEX II concept GeneralObstruction.</rdfs:comment>
        <rdfs:label>General Obstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GeneralObstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GoSlowOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GoSlowOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>As a form of protest, several vehicles are driving in a convoy at a low speed which is affecting the normal traffic flow. This concept and description are from the DATEX II concept goSlowOperation.</rdfs:comment>
        <rdfs:label>Go Slow Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GoSlowOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GolfTournament -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GolfTournament">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Golf tournament event that could disrupt traffic. This concept and description are from the DATEX II concept golfTournament.</rdfs:comment>
        <rdfs:label>Golf Tournament</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GolfTournament</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GrassCuttingWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GrassCuttingWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Grass cutting work. This concept and description are from the DATEX II concept grassCuttingWork.</rdfs:comment>
        <rdfs:label>Grass Cutting Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GrassCuttingWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GrassFire -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GrassFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to a grass fire adjacent to some transport infrastructure. This concept and description are a generalised version of the DATEX II concept grassFire.</rdfs:comment>
        <rdfs:label>Grass Fire</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GrassFire</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GunfireOnRoadway -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GunfireOnRoadway">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation involving gunfire, perceived or actual, on or near some transport infrastructure through an act of terrorism or crime, which could disrupt traffic. This concept and description are a generalised version of the DATEX II concept gunfireOnRoadway.</rdfs:comment>
        <rdfs:label>Gunfire On Roadway</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GunfireOnRoadway</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#GustyWinds -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#GustyWinds">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Constantly varying winds, significant at times. This concept and description are from the DATEX II concept gustyWinds.</rdfs:comment>
        <rdfs:label>Gusty Winds</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#GustyWinds</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Hail -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Hail">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Falling ice pellets or frozen rain. This concept and description are from the DATEX II concept hail.</rdfs:comment>
        <rdfs:label>Hail</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Hail</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HardShoulderRunningInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HardShoulderRunningInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>The hard shoulder is open as an operational lane. This concept and description are from the DATEX II concept hardShoulderRunningInOperation.</rdfs:comment>
        <rdfs:label>Hard Shoulder Running In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HardShoulderRunningInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Hazardous -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Hazardous">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>Driving conditions are hazardous due to environmental conditions. This concept and description are from the DATEX II concept hazardous.</rdfs:comment>
        <rdfs:label>Hazardous</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Hazardous</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeadOnCollision -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeadOnCollision">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
        <rdfs:comment>Collision of vehicle with another vehicle head on. This concept and description are from the DATEX II concept headOnCollision.</rdfs:comment>
        <rdfs:label>Head On Collision</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeadOnCollision</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeadOnOrSideCollision -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeadOnOrSideCollision">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
        <rdfs:comment>Collision of vehicle with another vehicle either head on or sideways. This concept and description are from the DATEX II concept headOnOrSideCollision.</rdfs:comment>
        <rdfs:label>Head On Or Side Collision</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeadOnOrSideCollision</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeavyFrost -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeavyFrost">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>A thick coating of frost. This concept and description are adaptations of the DATEX II concept heavyFrost.</rdfs:comment>
        <rdfs:label>Heavy Frost</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeavyFrost</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeavyRain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeavyRain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Heavy rainfall, limiting visibility to 50m or less. This concept and description are from the DATEX II concept heavyRain.</rdfs:comment>
        <rdfs:label>Heavy Rain</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeavyRain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeavySnowfall -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeavySnowfall">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Dense falling snow, limiting visibility to 50m or less. This concept and description are from the DATEX II concept heavySnowfall.</rdfs:comment>
        <rdfs:label>Heavy Snowfall</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeavySnowfall</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeavyTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeavyTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AbnormalTraffic"/>
        <rdfs:comment>Traffic is heavy at the specified location. For road traffic, DATEX II defines this as the average speed is between 75% and 90% of its free-flow level.  This concept and description are adaptations of the DATEX II concept heavyTraffic.</rdfs:comment>
        <rdfs:label>Heavy Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeavyTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HeightRestrictionInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HeightRestrictionInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>A height restriction is in operation. This concept and description are from the DATEX II concept heightRestrictionInOperation.</rdfs:comment>
        <rdfs:label>Height Restriction In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HeightRestrictionInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HelicopterRescue -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HelicopterRescue">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Helicopter rescue. This concept and description are from the DATEX II concept helicopterRescue.</rdfs:comment>
        <rdfs:label>Helicopter Rescue</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HelicopterRescue</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HerdOfAnimalsOnTheInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HerdOfAnimalsOnTheInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AnimalPresenceObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to a herd of animals on transport infrastructure. This concept and description a generalised version of the DATEX II concept herdOfAnimalsOnTheRoad.</rdfs:comment>
        <rdfs:label>Herd Of Animals On The Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HerdOfAnimalsOnTheRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HighSpeedEmergencyVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HighSpeedEmergencyVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Emergency service vehicles progressing at high speed along the roadway in response to or en route from an emergency situation. This concept and description are from the DATEX II concept highSpeedEmergencyVehicle.</rdfs:comment>
        <rdfs:label>High Speed Emergency Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HighSpeedEmergencyVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HockeyGame -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HockeyGame">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Hockey game event that could disrupt traffic. This concept and description are from the DATEX II concept hockeyGame.</rdfs:comment>
        <rdfs:label>Hockey Game</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HockeyGame</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HorseRaceMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HorseRaceMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Horse race meeting that could disrupt traffic. This concept and description are from the DATEX II concept horseRaceMeeting.</rdfs:comment>
        <rdfs:label>Horse Race Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HorseRaceMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#HurricaneForceWinds -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#HurricaneForceWinds">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Winds over 120 km/h. This concept and description are from the DATEX II concept hurricaneForceWinds.</rdfs:comment>
        <rdfs:label>Hurricane Force Winds</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#HurricaneForceWinds</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Ice -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Ice">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Presence of ice (of any kind) on transport infrastructure. This concept and description are a generalised version of the DATEX II concept ice.</rdfs:comment>
        <rdfs:label>Ice</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Ice</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#IceBuildUp -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#IceBuildUp">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Ice is building up on the infrastructure surface. This concept and description are a generalised version of the DATEX II concept iceBuildUp.</rdfs:comment>
        <rdfs:label>Ice Build Up</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#IceBuildUp</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#IceWithWheelBarTracks -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#IceWithWheelBarTracks">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Ice on the road frozen in the form of wheel tracks. This concept and description are from the DATEX II concept iceWithWheelBarTracks.</rdfs:comment>
        <rdfs:label>Ice With Wheel Bar Tracks</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#IceWithWheelBarTracks</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#IcyPatches -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#IcyPatches">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Icy patches (i.e. intermittent ice on the surface of transport infrastructure). This concept and description are a generalised version of the DATEX II concept icyPatches.</rdfs:comment>
        <rdfs:label>Icy Patches</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#IcyPatches</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#IllVehicleOccupants -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#IllVehicleOccupants">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>One or more occupants of a vehicle are seriously ill, possibly requiring specialist services or assistance. This may disrupt normal traffic flow. This concept and description are from the DATEX II concept illVehicleOccupants.</rdfs:comment>
        <rdfs:label>Ill Vehicle Occupants</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#IllVehicleOccupants</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Impossible -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Impossible">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>Current conditions are making driving impossible. This concept and description are from the DATEX II concept impossible.</rdfs:comment>
        <rdfs:label>Impossible</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Impossible</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureConstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureConstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureWorks"/>
        <rdfs:comment>Work involving the construction of new infrastructure. This concept and description are from the DATEX II concept ConstructionWorks.</rdfs:comment>
        <rdfs:label>Infrastructure Construction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ConstructionWorks</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureDamageObstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Obstruction"/>
        <rdfs:comment>An obstruction on some transport infrastructure resulting from the failure or damage of infrastructure on, under, above or nearby. This concept and description are a generalised version of the DATEX II concept InfrastructureDamageObstruction.</rdfs:comment>
        <rdfs:label>Infrastructure Damage Obstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#InfrastructureDamageObstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>Infrastructure, equipment or system which is not in an operational state. This concept and description are based on the DATEX II concept EquipmentOrSystemFault.</rdfs:comment>
        <rdfs:label>Infrastructure Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EquipmentOrSystemFault</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>Infrastructure, equipment or system which is faulty, malfunctioning or not in a fully operational state. This concept and description are based on the DATEX II concept EquipmentOrSystemFault.</rdfs:comment>
        <rdfs:label>Infrastructure Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#EquipmentOrSystemFault</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureImprovementOrUpgrading -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureImprovementOrUpgrading">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureConstruction"/>
        <rdfs:comment>Construction work associated with improvements to the infrastructure or its layout or with it upgrading. This concept and description are a generalised version of the DATEX II concept roadImprovementOrUpgrading.</rdfs:comment>
        <rdfs:label>Infrastructure Improvement Or Upgrading</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadImprovementOrUpgrading</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureMaintenance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureMaintenance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureWorks"/>
        <rdfs:comment>Infrastructure work involving the maintenance or installation of infrastructure. concept and description are a generalised version of the DATEX II concept MaintenanceWorks.</rdfs:comment>
        <rdfs:label>Infrastructure Maintenance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MaintenanceWorks</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSideAssistance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSideAssistance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#OperatorAction"/>
        <rdfs:comment>Details of assistance required or being given at the side of transport infrastructure. This concept and description are a generalised version of the DATEX II concept RoadsideAssistance.</rdfs:comment>
        <rdfs:label>Infrastructure Side Assistance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadsideAssistance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSideCommunicationsSystemFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSideCommunicationsSystemFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of communications system at the side of infrastucture which is used by one or more equipments or systems. This concept and description are based on the DATEX II concept roadsideCommunicationsSystem.</rdfs:comment>
        <rdfs:label>Side of Infrastructure Communications System Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadsideCommunicationsSystem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSideCommunicationsSystemFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSideCommunicationsSystemFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning communications system at side of infrastructure which is used by one or more roadside equipments or systems. This concept and description are based on the DATEX II concept roadsideCommunicationsSystem.</rdfs:comment>
        <rdfs:label>Side of Infrastructure Communications System Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadsideCommunicationsSystem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSidePowerSystemFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSidePowerSystemFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of power system at the side of infrastructure which is used by one or more equipments or system. This concept and description are based on the DATEX II concept roadsidePowerSystem.</rdfs:comment>
        <rdfs:label>Side of Infrastructure Power System Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadsidePowerSystem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSidePowerSystemFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSidePowerSystemFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning power system at side of infrastructure which is used by one or more roadside equipments or systems. This concept and description are based on the DATEX II concept roadsidePowerSystem.</rdfs:comment>
        <rdfs:label>Side of Infrastructure Power System Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadsidePowerSystem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSideWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSideWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Work of an unspecified nature carried out at the side of transport infrastructure. This concept and description are a generalised version of the DATEX II concept roadsideWork.</rdfs:comment>
        <rdfs:label>Infrastructure Side Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadsideWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureSurfaceInPoorCondition -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureSurfaceInPoorCondition">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>The infrastructure surface is damaged, severely rutted or potholed (i.e. it is in a poor state of repair). This concept and description are a generalised version of the DATEX II concept roadSurfaceInPoorCondition.</rdfs:comment>
        <rdfs:label>Infrastructure Surface In Poor Condition</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadSurfaceInPoorCondition</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureWorks -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureWorks">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#OperatorAction"/>
        <rdfs:comment>Infrastructure maintenance or improvement activity of an unspecified nature which may potentially cause disruption to travel. This concept and description are a generalised version of the DATEX II concept roadworks.</rdfs:comment>
        <rdfs:label>Infrastructure Works</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Roadworks</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InfrastructureWorksClearance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InfrastructureWorksClearance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Infrastructure works are completed and are being cleared. This concept and description are a generalised version the DATEX II concept roadworksClearance.</rdfs:comment>
        <rdfs:label>Inffrastructure Works Clearance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadworksClearance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InstallationWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InstallationWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Installation of new equipments or systems on or along-side some infrastructure. This concept and description are a generalised version of the DATEX II concept installationWork.</rdfs:comment>
        <rdfs:label>Installation Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#InstallationWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#IntermittentShortTermClosures -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#IntermittentShortTermClosures">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Road closures occur intermittently on a specified road in a given direction for short durations. This concept and description are adaptations of the DATEX II concept intermittentShortTermClosures.</rdfs:comment>
        <rdfs:label>Intermittent Short Term Closures</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#IntermittentShortTermClosures</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#InternationalSportsMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#InternationalSportsMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Large sporting event of an international nature that could disrupt traffic. This concept and description are from the DATEX II concept internationalSportsMeeting.</rdfs:comment>
        <rdfs:label>International Sports Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#InternationalSportsMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#JackknifedArticulatedLorry -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#JackknifedArticulatedLorry">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#JackknifedVehicle"/>
        <rdfs:comment>Includes all situations resulting in a heavy goods vehicle folding together in an accidental skidding movement on the carriageway. This concept and description are from the DATEX II concept jackknifedArticulatedLorry.</rdfs:comment>
        <rdfs:label>Jackknifed Articulated Lorry</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#JackknifedArticulatedLorry</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#JackknifedCaravan -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#JackknifedCaravan">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#JackknifedVehicle"/>
        <rdfs:comment>Includes all situations resulting in a vehicle and caravan folding together in an accidental skidding movement on the carriageway. This concept and description are from the DATEX II concept jackknifedCaravan.</rdfs:comment>
        <rdfs:label>Jackknifed Caravan</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#JackknifedCaravan</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#JackknifedRailwayVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#JackknifedRailwayVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#JackknifedVehicle"/>
        <rdfs:comment>Includes all situations resulting in a rail vehicle (carrage, engine, etc.) folding together in an accidental movement.</rdfs:comment>
        <rdfs:label>Jackknifed Railway Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#JackknifedTrailer -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#JackknifedTrailer">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#JackknifedVehicle"/>
        <rdfs:comment>Includes all situations resulting in a vehicle and trailer folding together in an accidental skidding movement on the carriageway. This concept and description are from the DATEX II concept jackknifedTrailer.</rdfs:comment>
        <rdfs:label>Jackknifed Trailer</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#JackknifedTrailer</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#JackknifedVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#JackknifedVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all situations resulting in a vehicle folding together in an accidental  movement, such as skidding.</rdfs:comment>
        <rdfs:label>Jackknifed Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#JuridicalReconstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#JuridicalReconstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>An operation involving the juridical reconstruction of events for the purposes of judicial or legal proceedings. This concept and description are from the DATEX II concept juridicalReconstruction.</rdfs:comment>
        <rdfs:label>Juridical Reconstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#JuridicalReconstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Landslips -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Landslips">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Transport infrastructure obstructed or partially obstructed due to landslides. This concept and description are a generalised version of the DATEX II concept landslips.</rdfs:comment>
        <rdfs:label>Landslips</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Landslips</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LaneClosure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LaneClosure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Lane closure in operation at a location. This concept and description are adaptations of the DATEX II concept laneClosures.</rdfs:comment>
        <rdfs:label>Lane Closure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LaneClosures</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LaneControlSignFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LaneControlSignFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of signs used to control lane usage (e.g. in tidal flow systems or hard shoulder running). This concept and description are based on the DATEX II concept laneControlSigns.</rdfs:comment>
        <rdfs:label>Lane Control Sign Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LaneControlSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LaneControlSignFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LaneControlSignFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning signs used to control lane usage (e.g. in tidal flow systems or hard shoulder running). This concept and description are based on the DATEX II concept laneControlSigns.</rdfs:comment>
        <rdfs:label>Lane Control Sign Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LaneControlSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LanesDeviated -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LanesDeviated">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Lane deviations are in operation at the specified location. This concept and description are from the DATEX II concept lanesDeviated.</rdfs:comment>
        <rdfs:label>Lanes Deviated</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LanesDeviated</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LargeAnimalsOnTheInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LargeAnimalsOnTheInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AnimalPresenceObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to large animals on transport infrastructure. This concept and description are a generalised version of the DATEX II concept largeAnimalsOnTheRoad.</rdfs:comment>
        <rdfs:label>Large Animals On The Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LargeAnimalsOnTheRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LeavesOnInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LeavesOnInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Leaves lying on transport infrastructure. This concept and description are a generalised version of the DATEX II concept leavesOnRoad.</rdfs:comment>
        <rdfs:label>Leaves On Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LeavesOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LevelCrossingFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LevelCrossingFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of a level crossing (barriers and signals). This concept and description are based on the DATEX II concept levelCrossing.</rdfs:comment>
        <rdfs:label>Level Crossing Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LevelCrossing</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LevelCrossingFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LevelCrossingFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning level crossing (barriers and signals). This concept and description are based on the DATEX II concept levelCrossing.</rdfs:comment>
        <rdfs:label>Level Crossing Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LevelCrossing</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LitterClearance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LitterClearance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Work to collect litter from the transport infrastructure and/or adjacent verges. This concept and description are a generalised version of the DATEX II concept litterClearance.</rdfs:comment>
        <rdfs:label>Litter Clearance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LitterClearance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LongLoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LongLoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A vehicle of length greater than that normally allowed which may cause traffic disruption. This concept and description are from the DATEX II concept longLoad.</rdfs:comment>
        <rdfs:label>Long Load</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LongLoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LooseChippings -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LooseChippings">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Loose chippings transport infrastructure. This concept and description are a generalised version of the DATEX II concept looseChippings.</rdfs:comment>
        <rdfs:label>Loose Chippings</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LooseChippings</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LooseSandOnInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LooseSandOnInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Loose sand on transport infrastructure. This concept and description are a generalised version of the DATEX II concept looseSandOnRoad.</rdfs:comment>
        <rdfs:label>Loose Sand On Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LooseSandOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LooseSnow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LooseSnow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Powdery snow on the infrastructure which is subject to being blown by the wind. This concept and description are a generalised version of the DATEX II concept looseSnow.</rdfs:comment>
        <rdfs:label>Loose Snow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LooseSnow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#LowSunGlare -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#LowSunGlare">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Difficult visibility conditions created by low elevation sunlight. This concept and description are from the DATEX II concept lowSunGlare.</rdfs:comment>
        <rdfs:label>Low Sun Glare</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#LowSunGlare</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MaintenanceWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MaintenanceWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Maintenance of transport and associated infrastructure or equipments. This concept and description are a generalised version of the the DATEX II concept maintenanceWork.</rdfs:comment>
        <rdfs:label>Maintenance Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MaintenanceWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MajorEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MajorEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Significant organised event either on or near some transport infrastructure which could disrupt traffic. This concept and description are a generalised version of the DATEX II concept majorEvent.</rdfs:comment>
        <rdfs:label>Major Event</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MajorEvent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Marathon -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Marathon">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Marathon, cross-country or road running event that could disrupt traffic. This concept and description are from the DATEX II concept marathon.</rdfs:comment>
        <rdfs:label>Marathon</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Marathon</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#March -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#March">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where people are walking together in large groups for a common purpose, with potential to disrupt traffic. This concept and description are from the DATEX II concept march.</rdfs:comment>
        <rdfs:label>March</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#March</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Market -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Market">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Periodic (e.g. weekly) gathering for buying and selling, which could disrupt traffic. This concept and description are from the DATEX II concept market.</rdfs:comment>
        <rdfs:label>Market</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Market</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Match -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Match">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Sports match of unspecified type that could disrupt traffic. This concept and description are from the DATEX II concept match.</rdfs:comment>
        <rdfs:label>Match</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Match</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MatrixSignFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MatrixSignFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of matrix signs. These normally comprise a symbol display area surrounded by four lights (usually amber) which flash when a symbol is displayed.  This concept and description are based on the DATEX II concept matrixSigns.</rdfs:comment>
        <rdfs:label>Matrix Signs Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MatrixSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MatrixSignFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MatrixSignFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning matrix signs. These normally comprise a symbol display area surrounded by four lights (usually amber) which flash when a symbol is displayed.  This concept and description are based on the DATEX II concept matrixSigns.</rdfs:comment>
        <rdfs:label>Matrix Sign Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MatrixSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MilitaryConvoy -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MilitaryConvoy">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A group of military vehicles moving together in formation which may cause traffic disruption. This concept and description are from the DATEX II concept militaryConvoy.</rdfs:comment>
        <rdfs:label>Military Convoy</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MilitaryConvoy</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ModerateFog -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ModerateFog">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Misty conditions impairing vision over 100m. This concept and description are from the DATEX II concept moderateFog.</rdfs:comment>
        <rdfs:label>Moderate Fog</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ModerateFog</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MotorShow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MotorShow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Motor show which could disrupt traffic. This concept and description are from the DATEX II concept motorShow.</rdfs:comment>
        <rdfs:label>Motor Show</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MotorShow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MotorSportRaceMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MotorSportRaceMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Motor sport race meeting that could disrupt traffic. This concept and description are from the DATEX II concept motorSportRaceMeeting.</rdfs:comment>
        <rdfs:label>Motor Sport Race Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MotorSportRaceMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MudOnInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MudOnInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Mud on transport infrastructure. This concept and description are a generalised version of the DATEX II concept mudOnRoad.</rdfs:comment>
        <rdfs:label>Mud On Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MudOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MudSlide -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MudSlide">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Transport infrastructure obstructed or partially obstructed due to mudslides. This concept and description are a generalised version of the DATEX II concept mudSlide.</rdfs:comment>
        <rdfs:label>Mud Slide</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MudSlide</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MultipleVehicleCollision -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MultipleVehicleCollision">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
        <rdfs:comment>Multiple vehicles involved in a collision. This concept and description are from the DATEX II concept multipleVehicleCollision.</rdfs:comment>
        <rdfs:label>Multiple Vehicle Collision</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MultipleVehicleCollision</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#MultivehicleAccident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#MultivehicleAccident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all accidents involving three or more vehicles. This concept and description are from the DATEX II concept multivehicleAccident.</rdfs:comment>
        <rdfs:label>Multivehicle Accident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#MultivehicleAccident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#NarrowLanes -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#NarrowLanes">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Normal lane widths are temporarily reduced. This concept and description are from the DATEX II concept narrowLanes.</rdfs:comment>
        <rdfs:label>Narrow Lanes</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#NarrowLanes</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#NetworkManagement -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#NetworkManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#OperatorAction"/>
        <rdfs:comment>Network management action which is applicable to the transport network and its users. This concept and description are a generalised version the DATEX II concept NetworkManagement.</rdfs:comment>
        <rdfs:label>Network Management</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#NetworkManagement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#NewRoadworksLayout -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#NewRoadworksLayout">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>A new layout of lanes/carriageway has been implemented associated with roadworks. This concept and description are from the DATEX II concept newRoadworksLayout.</rdfs:comment>
        <rdfs:label>New Roadworks Layout</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#NewRoadworksLayout</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Normal -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Normal">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>Driving conditions are normal. This concept and description are from the DATEX II concept normal.</rdfs:comment>
        <rdfs:label>Normal</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Normal</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#NormalWinterConditionsForPedestrians -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#NormalWinterConditionsForPedestrians">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Conditions for pedestrians are consistent with those normally expected in winter. This concept and description are from the DATEX II concept normalWinterConditionsForPedestrians.</rdfs:comment>
        <rdfs:label>Normal Winter Conditions For Pedestrians</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#NormalWinterConditionsForPedestrians</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ObstacleSignalling -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ObstacleSignalling">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>Signs are being put out before or around an obstacle to protect drivers. This concept and description are from the DATEX II concept obstacleSignalling.</rdfs:comment>
        <rdfs:label>Obstacle Signalling</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ObstacleSignalling</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Obstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Obstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>Any stationary or moving obstacle of a physical nature (e.g. obstacles or vehicles from an earlier accident, shed loads on carriageway, rock fall, abnormal or dangerous loads, or animals etc.) which could disrupt or endanger traffic. This concept and description are from the DATEX II concept Obstruction.</rdfs:comment>
        <rdfs:label>Obstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Obstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OilOnInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OilOnInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Oil on infrastructure. This concept and description are a generalised version of the DATEX II concept oilOnRoad.</rdfs:comment>
        <rdfs:label>Oil On Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OilOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OilSpillageAccident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OilSpillageAccident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#SpillageAccident"/>
        <rdfs:comment>Includes all situations resulting in a spillage of oil. This concept and description are a generalised version the DATEX II concept oilSpillageAccident.</rdfs:comment>
        <rdfs:label>Oil Spillage Accident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OilSpillageAccident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OperatorAction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OperatorAction">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/EventType"/>
        <rdfs:comment>Actions that an operator can decide to implement to prevent or help correct dangerous or poor transport or travel conditions. This concept and description is based on the DATEX II concept OperatorAction.</rdfs:comment>
        <rdfs:label>Operator Action</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OperatorAction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OverheadWorks -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OverheadWorks">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Works which are overhead of the transport infrastructure. This concept and description are a generalised version of the DATEX II concept overheadWorks.</rdfs:comment>
        <rdfs:label>Overhead Works</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OverheadWorks</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OverheightVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OverheightVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Vehicles of height greater than normally allowed which may cause traffic disruption. This concept and description are from the DATEX II concept overheightVehicle.</rdfs:comment>
        <rdfs:label>Overheight Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OverheightVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OvernightClosures -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OvernightClosures">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Every night the road is closed to vehicles, either all or those with specified characteristics by decision of the appropriate authorities. This concept and description are adaptations of the DATEX II concept overnightClosures.</rdfs:comment>
        <rdfs:label>Overnight Closures</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OvernightClosures</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OverturnedHeavyLorry -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OverturnedHeavyLorry">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#OverturnedVehicle"/>
        <rdfs:comment>Includes all situations resulting in the overturning of a heavy goods vehicle on the carriageway. This concept and description are from the DATEX II concept overturnedHeavyLorry.</rdfs:comment>
        <rdfs:label>Overturned Heavy Lorry</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OverturnedHeavyLorry</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OverturnedTrailer -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OverturnedTrailer">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#OverturnedVehicle"/>
        <rdfs:comment>Includes all situations resulting in the overturning of a trailer. This concept and description are from the DATEX II concept overturnedTrailer.</rdfs:comment>
        <rdfs:label>Overturned Trailer</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OverturnedTrailer</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OverturnedVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OverturnedVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all situations resulting in the overturning of a vehicle (of unspecified type) on the carriageway. This concept and description are from the DATEX II concept overturnedVehicle.</rdfs:comment>
        <rdfs:label>Overturned Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OverturnedVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#OzonePollution -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#OzonePollution">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>High concentrations of ozone are present. This concept and description are from the DATEX II concept ozonePollution.</rdfs:comment>
        <rdfs:label>Ozone Pollution</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#OzonePollution</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PackedSnow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PackedSnow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Packed snow (heavily trafficked) on the transport infrastructure. This concept and description are a generalised version of the DATEX II concept packedSnow.</rdfs:comment>
        <rdfs:label>Packed Snow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PackedSnow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Parade -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Parade">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Formal display or organised procession which could disrupt traffic. This concept and description are from the DATEX II concept parade.</rdfs:comment>
        <rdfs:label>Parade</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Parade</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PassableWithCare -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PassableWithCare">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>The roadway is passable to vehicles with driver care. This concept and description are from the DATEX II concept passableWithCare.</rdfs:comment>
        <rdfs:label>Passable With Care</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PassableWithCare</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PassengerAssistance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PassengerAssistance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Bus, rail, ferry, etc. passenger assistance. This concept and description are a generalised version of the DATEX II concept busPassengerAssistance.</rdfs:comment>
        <rdfs:label>Passenger Assistance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BusPassengerAssistance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PatchyFog -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PatchyFog">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Fog, in which intermittent areas of dense fog may be encountered. This concept and description are from the DATEX II concept patchyFog.</rdfs:comment>
        <rdfs:label>Patchy Fog</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PatchyFog</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PetrolOnInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PetrolOnInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:comment>Petrol on infrascture. This concept and description are a generalised version of the DATEX II concept petrolOnRoad.</rdfs:comment>
        <rdfs:label>Petrol On Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PetrolOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Plan -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Plan">
        <rdfs:comment>Plan provides an extension point for users of the ontology to describe an agent&apos;s plan that may be impacted by an event.</rdfs:comment>
        <rdfs:label>Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PoliceCheckPoint -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PoliceCheckPoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary operation established on or adjacent to the transport infrastructure for use by police or other authorities. This concept and description are a generalised version of the DATEX II concept policeCheckPoint.</rdfs:comment>
        <rdfs:label>Police Check Point</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PoliceCheckPoint</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PoliceInvestigation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PoliceInvestigation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A temporary operation established on or adjacent to the transport infrastructure by the police associated with an ongoing investigation. This concept and description are a generalised version of the DATEX II concept policeInvestigation.</rdfs:comment>
        <rdfs:label>Police Investigation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PoliceInvestigation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PoliceSpeedChecksInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PoliceSpeedChecksInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#SpeedManagement"/>
        <rdfs:comment>Police speed checks are in operation. This concept and description are from the DATEX II concept policeSpeedChecksInOperation.</rdfs:comment>
        <rdfs:label>Police Speed Checks In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PoliceSpeedChecksInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Pollution -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Pollution">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Pollution of an unspecified nature. This concept and description are from the DATEX II concept pollution.</rdfs:comment>
        <rdfs:label>Pollution</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Pollution</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PrecipitationInTheArea -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PrecipitationInTheArea">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Unspecified precipitation is falling on the area. This concept and description are from the DATEX II concept precipitationInTheArea.</rdfs:comment>
        <rdfs:label>Precipitation In The Area</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PrecipitationInTheArea</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Procession -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Procession">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>An organised procession which could disrupt traffic. This concept and description are from the DATEX II concept procession.</rdfs:comment>
        <rdfs:label>Procession</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Procession</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ProhibitedVehicleOnTheRoadway -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ProhibitedVehicleOnTheRoadway">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Vehicles not normally permitted on the highway are present which may cause traffic disruption. This concept and description are from the DATEX II concept prohibitedVehicleOnTheRoadway.</rdfs:comment>
        <rdfs:label>Prohibited Vehicle On The Roadway</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ProhibitedVehicleOnTheRoadway</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PublicDisturbance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PublicDisturbance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation of public disorder, with potential to disrupt traffic. This concept and description are from the DATEX II concept publicDisturbance.</rdfs:comment>
        <rdfs:label>Public Disturbance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PublicDisturbance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PublicEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PublicEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Activity"/>
        <rdfs:comment>Organised public event which could disrupt traffic. This concept and description are from the DATEX II concept PublicEvent.</rdfs:comment>
        <rdfs:label>Public Event</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#PublicEvent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PublicTransportCancellation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PublicTransportCancellation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicTransportEvent"/>
        <rdfs:comment>A cancellation of a public transport service, route, trip, etc.</rdfs:comment>
        <rdfs:label>Public Transport Cancellation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PublicTransportDelay -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PublicTransportDelay">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicTransportEvent"/>
        <rdfs:comment>A delay to a public transport service, trip, route, etc.</rdfs:comment>
        <rdfs:label>Public Transport Delay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PublicTransportDiversion -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PublicTransportDiversion">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicTransportEvent"/>
        <rdfs:comment>A diversion to the typical route of a public transport service, trip, etc.</rdfs:comment>
        <rdfs:label>Public Transport Diversion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#PublicTransportEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#PublicTransportEvent">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/EventType"/>
        <rdfs:comment>A public transport event is an event that features some form of public transport: bus, rail, air, ferry, etc.</rdfs:comment>
        <rdfs:label>Public Transport Event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#QueuingTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#QueuingTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AbnormalTraffic"/>
        <rdfs:comment>Traffic is queuing at the specified location, although there is still some traffic movement.  For road traffic, DATEX II defines this as i.e. average speed is between 10% and 25% of its free-flow level). This concept and description are adaptations of the DATEX II concept queuingTraffic.</rdfs:comment>
        <rdfs:label>Queuing Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#QueuingTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RaceMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RaceMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Race meeting (other than horse or motor sport) that could disrupt traffic. This concept and description are from the DATEX II concept raceMeeting.</rdfs:comment>
        <rdfs:label>Race Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RaceMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RadioactiveLeakAlert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RadioactiveLeakAlert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>An alert to a radioactive leak which may endanger the public and hence may cause traffic disruption. This concept and description are from the DATEX II concept radioactiveLeakAlert.</rdfs:comment>
        <rdfs:label>Radioactive Leak Alert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RadioactiveLeakAlert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Rain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Rain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Rain, visibility more than 50m. This concept and description are from the DATEX II concept rain.</rdfs:comment>
        <rdfs:label>Rain</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Rain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RainChangingToSnow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RainChangingToSnow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Falling rain is changing to snow. This concept and description are from the DATEX II concept rainChangingToSnow.</rdfs:comment>
        <rdfs:label>Rain Changing To Snow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RainChangingToSnow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RampControlFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RampControlFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of ramp control equipment. This concept and description are based on the DATEX II concept rampControls.</rdfs:comment>
        <rdfs:label>Ramp Control Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RampControls</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RampControlFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RampControlFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning ramp control equipment. This concept and description are based on the DATEX II concept rampControls.</rdfs:comment>
        <rdfs:label>Ramp Control Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RampControls</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RampMeteringInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RampMeteringInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>Ramp metering is now active at the specified location. This concept and description are from the DATEX II concept rampMeteringInOperation.</rdfs:comment>
        <rdfs:label>Ramp Metering In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RampMeteringInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RearCollision -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RearCollision">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
        <rdfs:comment>Includes all accidents where one or more vehicles have collided with the rear of one or more other vehicles. This concept and description are from the DATEX II concept rearCollision.</rdfs:comment>
        <rdfs:label>Rear Collision</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RearCollision</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RepairWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RepairWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Repair work to infrastructure or equipments. This concept and description are a generalised version of the DATEX II concept repairWork.</rdfs:comment>
        <rdfs:label>Repair Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RepairWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ResurfacingWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ResurfacingWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Work associated with relaying or renewal of road, runway, or similar infrastructure. This concept and description are a generalised version of the DATEX II concept resurfacingWork.</rdfs:comment>
        <rdfs:label>Resurfacing Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ResurfacingWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Riot -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Riot">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation of public disorder involving violent behaviour and/or destruction of property with the potential to disrupt traffic. This concept and description are from the DATEX II concept riot.</rdfs:comment>
        <rdfs:label>Riot</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Riot</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadCleared -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadCleared">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>The road has been cleared of earlier reported problems. This concept and description are from the DATEX II concept roadCleared.</rdfs:comment>
        <rdfs:label>Road Cleared</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadCleared</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadClosure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadClosure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>A road is closed to vehicles with the specified characteristics or all, if none defined, in the specified direction. This concept and description are adaptions of the DATEX II concept roadClosed.</rdfs:comment>
        <rdfs:label>Road Closure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadClosed</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadMarkingWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadMarkingWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Striping and repainting of road markings, plus placement or replacement of reflecting studs (cats&apos; eyes). This concept and description are from the DATEX II concept roadMarkingWork.</rdfs:comment>
        <rdfs:label>Road Marking Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadMarkingWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadOperatorCheckPoint -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadOperatorCheckPoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary operation established on or adjacent to the carriageway for use by the road operator, such as for survey or inspection purposes, but not for traffic management purposes. This concept and description are from the DATEX II concept roadOperatorCheckPoint.</rdfs:comment>
        <rdfs:label>Road Operator Check Point</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadOperatorCheckPoint</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#NetworkManagement"/>
        <rdfs:comment>Road, carriageway or lane management action that is instigated by the network/road operator. This concept and description are from the DATEX II concept RoadOrCarriagewayOrLaneManagement.</rdfs:comment>
        <rdfs:label>Road Or Carriageway Or Lane Management</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadOrCarriagewayOrLaneManagement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadSurfaceMelting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadSurfaceMelting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>The infrastructure surface is melting, or has melted due to abnormally high temperatures. This concept and description are a generalised version of the DATEX II concept roadSurfaceMelting.</rdfs:comment>
        <rdfs:label>Road Surface Melting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadSurfaceMelting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadWideningWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadWideningWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureConstruction"/>
        <rdfs:comment>Road widening work at the specified location. This concept and description are from the DATEX II concept roadWideningWork.</rdfs:comment>
        <rdfs:label>Road Widening Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RoadWideningWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RoadWorks -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RoadWorks">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Road maintenance or improvement activity of an unspecified nature which may potentially cause disruption to travel. This concept and description are from the DATEX II concept roadworks.</rdfs:comment>
        <rdfs:label>Roadworks</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RockFallPreventativeMaintenance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RockFallPreventativeMaintenance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Rock fall preventative maintenance. This concept and description are from the DATEX II concept rockFallPreventativeMaintenance.</rdfs:comment>
        <rdfs:label>Rock Fall Preventative Maintenance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RockFallPreventativeMaintenance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Rockfalls -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Rockfalls">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Transport infrastructure obstructed or partially obstructed due to fallen rocks. This concept and description are a generalised version of the DATEX II concept rockfalls.</rdfs:comment>
        <rdfs:label>Rockfalls</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Rockfalls</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RollingRoadBlock -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RollingRoadBlock">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Traffic officers or police are driving slowly in front of a queue of traffic to create a gap in the traffic to allow for clearance activities to take place in safety on the road ahead. This concept and description are from the DATEX II concept rollingRoadBlock.</rdfs:comment>
        <rdfs:label>Rolling Road Block</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RollingRoadBlock</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RugbyMatch -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RugbyMatch">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Rugby match that could disrupt traffic. This concept and description are from the DATEX II concept rugbyMatch.</rdfs:comment>
        <rdfs:label>Rugby Match</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RugbyMatch</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#RushHourLaneInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#RushHourLaneInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Dedicated rush (peak) hour lane(s) are in operation. This concept and description are from the DATEX II concept rushHourLaneInOperation.</rdfs:comment>
        <rdfs:label>Rush Hour Lane In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#RushHourLaneInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Sabotage -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Sabotage">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation resulting from any act of sabotage. This concept and description are from the DATEX II concept sabotage.</rdfs:comment>
        <rdfs:label>Sabotage</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Sabotage</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SaltingInProgress -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SaltingInProgress">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Spreading of salt and / or grit on the road surface to prevent or melt snow or ice. This concept and description are from the DATEX II concept saltingInProgress.</rdfs:comment>
        <rdfs:label>Salting In Progress</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SaltingInProgress</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SaltingOrGrittingVehicleInUse -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SaltingOrGrittingVehicleInUse">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Salting and gritting vehicles are in use which may cause traffic disruption. This concept and description are from the DATEX II concept saltingOrGrittingVehicleInUse.</rdfs:comment>
        <rdfs:label>Salting Or Gritting Vehicle In Use</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SaltingOrGrittingVehicleInUse</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SandStorms -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SandStorms">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Sand blowing across some transport infrasturcture causing significantly reduced visibility. This concept and description are a generalised version of the DATEX II concept sandStorms.</rdfs:comment>
        <rdfs:label>Sand Storms</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SandStorms</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SecurityAlert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SecurityAlert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>An official alert to a perceived or actual threat of crime or terrorism, which could disrupt traffic. This concept and description are from the DATEX II concept securityAlert.</rdfs:comment>
        <rdfs:label>Security Alert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SecurityAlert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SecurityIncident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SecurityIncident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation related to a perceived or actual threat of crime or terrorism, which could disrupt traffic. This concept and description are from the DATEX II concept securityIncident.</rdfs:comment>
        <rdfs:label>Security Incident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SecurityIncident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SeriousAccident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SeriousAccident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all accidents believed to involve fatality or injury expected to require overnight hospitalisation. This concept and description are from the DATEX II concept seriousAccident.</rdfs:comment>
        <rdfs:label>Serious Accident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SeriousAccident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SeriousFire -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SeriousFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to a fire (other than a vehicle fire) adjacent to some transport infrastructure. This concept and description are a generalised version of the DATEX II concept seriousFire.</rdfs:comment>
        <rdfs:label>Serious Fire</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SeriousFire</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SeveralMajorEvents -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SeveralMajorEvents">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>A series of significant organised events either on or near some transport infrastructure which could disrupt traffic. This concept and description are a generalised version of the DATEX II concept severalMajorEvents.</rdfs:comment>
        <rdfs:label>Several Major Events</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SeveralMajorEvents</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SevereExhaustPollution -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SevereExhaustPollution">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Pollution from exhaust fumes has reached a level sufficient to cause concern. This concept and description are from the DATEX II concept severeExhaustPollution.</rdfs:comment>
        <rdfs:label>Severe Exhaust Pollution</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SevereExhaustPollution</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SevereSmog -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SevereSmog">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Very poor air quality resulting from smog. This concept and description are adaptations of the DATEX II concept severeSmog.</rdfs:comment>
        <rdfs:label>Severe Smog</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SevereSmog</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SewerOverflow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SewerOverflow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Transport infrastructure is obstructed or partially obstructed by overflows from one or more sewers. This concept and description are a generalised version of the DATEX II concept sewerOverflow.</rdfs:comment>
        <rdfs:label>Sewer Overflow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SewerOverflow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Show -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Show">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Entertainment event that could disrupt traffic. This concept and description are from the DATEX II concept show.</rdfs:comment>
        <rdfs:label>Show</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Show</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ShowJumping -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ShowJumping">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Horse showing jumping and tournament event that could disrupt traffic. This concept and description are from the DATEX II concept showJumping.</rdfs:comment>
        <rdfs:label>Show Jumping</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ShowJumping</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Showers -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Showers">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Light rain or intermittent rain. This concept and description are from the DATEX II concept showers.</rdfs:comment>
        <rdfs:label>Showers</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Showers</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SideCollision -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SideCollision">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
        <rdfs:comment>Includes all accidents where one or more vehicles have collided with the side of one or more other vehicles. This concept and description are from the DATEX II concept sideCollision.</rdfs:comment>
        <rdfs:label>Side Collision</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SideCollision</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SightseersObstructingAccess -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SightseersObstructingAccess">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>Attendees or sightseers to reported event(s) causing obstruction to access. This concept and description are from the DATEX II concept sightseersObstructingAccess.</rdfs:comment>
        <rdfs:label>Sightseers Obstructing Access</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SightseersObstructingAccess</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SingleAlternateLineTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SingleAlternateLineTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Traffic is being controlled to move in alternate single lines. This control may be undertaken by traffic lights or flagman. This concept and description are from the DATEX II concept singleAlternateLineTraffic.</rdfs:comment>
        <rdfs:label>Single Alternate Line Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SingleAlternateLineTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Sleet -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Sleet">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Rain mingled with snow or hail. This concept and description are from the DATEX II concept sleet.</rdfs:comment>
        <rdfs:label>Sleet</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Sleet</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SlipperyRoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SlipperyRoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>The road surface is slippery due to an unspecified non-weather related cause. This concept and description are from the DATEX II concept slipperyRoad.</rdfs:comment>
        <rdfs:label>Slippery Road</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SlipperyRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SlowMovingMaintenanceVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SlowMovingMaintenanceVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Slow moving vehicles undertaking maintenance work may pose a hazard to other vehicles. This concept and description are a generalised version of the DATEX II concept slowMovingMaintenanceVehicle.</rdfs:comment>
        <rdfs:label>Slow Moving Maintenance Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SlowMovingMaintenanceVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SlowTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SlowTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AbnormalTraffic"/>
        <rdfs:comment>Traffic is slow moving at the specified location, but not yet forming queues.  For road traffic, DATEX II defines this as  average speed is between 25% and 75% of its free-flow level. This concept and description are adaptations of the DATEX II concept slowTraffic.</rdfs:comment>
        <rdfs:label>Slow Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SlowTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SlowVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SlowVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A vehicle travelling at well below normal speeds which may cause traffic disruption. This concept and description are a generalised version of the DATEX II concept slowVehicle.</rdfs:comment>
        <rdfs:label>Slow Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SlowVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SlushOnRoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SlushOnRoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Melting snow (slush) on road. This concept and description are adaptations of the DATEX II concept slushOnRoad.</rdfs:comment>
        <rdfs:label>Slush On Road</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SlushOnRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SlushStrings -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SlushStrings">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Melting snow (slush) on the roadway is formed into wheel tracks. This concept and description are from the DATEX II concept slushStrings.</rdfs:comment>
        <rdfs:label>Slush Strings</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SlushStrings</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SmogAlert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SmogAlert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Environmental warning of poor air quality resulting from smog. This concept and description are from the DATEX II concept smogAlert.</rdfs:comment>
        <rdfs:label>Smog Alert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SmogAlert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SmokeHazard -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SmokeHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Smoke drifting across transport infrastructure causing significantly reduced visibility. This concept and description are adaptations of the DATEX II concept smokeHazard.</rdfs:comment>
        <rdfs:label>Smoke Hazard</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SmokeHazard</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SmokeOrFumes -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SmokeOrFumes">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Smoke or fumes which may hinder driving conditions or distract drivers. This concept and description are from the DATEX II concept smokeOrFumes.</rdfs:comment>
        <rdfs:label>Smoke Or Fumes</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SmokeOrFumes</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SnowChangingToRain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SnowChangingToRain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Falling snow is changing to rain. This concept and description are from the DATEX II concept snowChangingToRain.</rdfs:comment>
        <rdfs:label>Snow Changing To Rain</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SnowChangingToRain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SnowDrifts -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SnowDrifts">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Snow drifting is in progress or patches of deep snow are present due to earlier drifting. This concept and description are from the DATEX II concept snowDrifts.</rdfs:comment>
        <rdfs:label>Snow Drifts</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SnowDrifts</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SnowOnPavement -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SnowOnPavement">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Snow is on the pedestrian pavement. This concept and description are from the DATEX II concept snowOnPavement.</rdfs:comment>
        <rdfs:label>Snow On Pavement</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SnowOnPavement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SnowOnTheInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SnowOnTheInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Snow is lying on the inftrastructure surface. This concept and description are a generalised version of the DATEX II concept snowOnTheRoad.</rdfs:comment>
        <rdfs:label>Snow On The Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SnowOnTheRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Snowfall -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Snowfall">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Falling snow, visibility more than 50m. This concept and description are from the DATEX II concept snowfall.</rdfs:comment>
        <rdfs:label>Snowfall</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Snowfall</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Snowplough -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Snowplough">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Snowploughs are in use which may cause traffic disruption. This concept and description are from the DATEX II concept snowplough.</rdfs:comment>
        <rdfs:label>Snowplough</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Snowplough</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SnowploughsInUse -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SnowploughsInUse">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Snowploughs or other similar mechanical devices in use to clear snow from the road. This concept and description are from the DATEX II concept snowploughsInUse.</rdfs:comment>
        <rdfs:label>Snowploughs In Use</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SnowploughsInUse</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SpeedControlSignFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SpeedControlSignFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of signs used to control traffic speed. This concept and description are based on the DATEX II concept speedControlSigns.</rdfs:comment>
        <rdfs:label>Speed Control Signs Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SpeedControlSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SpeedControlSignFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SpeedControlSignFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning signs used to control traffic speed. This concept and description are based on the DATEX II concept speedControlSigns.</rdfs:comment>
        <rdfs:label>Speed Control Sign Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SpeedControlSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SpeedManagement -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SpeedManagement">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#NetworkManagement"/>
        <rdfs:comment>Speed management action that is instigated by the network/road operator. This concept and description are from the DATEX II concept SpeedManagement.</rdfs:comment>
        <rdfs:label>Speed Management</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SpeedManagement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SpeedRestriction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SpeedRestriction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#SpeedManagement"/>
        <rdfs:comment>A speed restriction is in operation. This concept and description are from the DATEX II concept speedRestrictionInOperation.</rdfs:comment>
        <rdfs:label>Speed Restriction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SpeedRestrictionInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SpillageAccident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SpillageAccident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all situations resulting in a spillage of some substance on transport infrastructure.</rdfs:comment>
        <rdfs:label>Spillage Accident</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SportsMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SportsMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Sports event of unspecified type that could disrupt traffic. This concept and description are from the DATEX II concept sportsMeeting.</rdfs:comment>
        <rdfs:label>Sports Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SportsMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SprayHazard -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SprayHazard">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Reduced visibility resulting from spray created by moving vehicles on a wet roadway. This concept and description are from the DATEX II concept sprayHazard.</rdfs:comment>
        <rdfs:label>Spray Hazard</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SprayHazard</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StateOccasion -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StateOccasion">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Public ceremony or visit of national or international significance which could disrupt traffic. This concept and description are from the DATEX II concept stateOccasion.</rdfs:comment>
        <rdfs:label>State Occasion</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StateOccasion</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StationaryTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StationaryTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AbnormalTraffic"/>
        <rdfs:comment>Traffic is stationary, or very near stationary, at the specified locatio.  For road traffic, DATEX II defines this as average speed is less than 10% of its free-flow level. This concept and description are adaptations of the DATEX II concept stationaryTraffic.</rdfs:comment>
        <rdfs:label>Stationary Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StationaryTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StormDamage -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StormDamage">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>Transport infrastructure obstructed or partially obstructed by debris caused by strong winds. This concept and description are a generalised version of the DATEX II concept stormDamage.</rdfs:comment>
        <rdfs:label>Storm Damage</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StormDamage</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StormForceWinds -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StormForceWinds">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Winds between 90 km/h and 120 km/h. This concept and description are from the DATEX II concept stormForceWinds.</rdfs:comment>
        <rdfs:label>Storm Force Winds</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StormForceWinds</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StreetLightingFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StreetLightingFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of street or road lighting. This concept and description are based on the DATEX II concept streetLighting.</rdfs:comment>
        <rdfs:label>Street Lighting Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StreetLighting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StreetLightingFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StreetLightingFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning street or road lighting. This concept and description are based on the DATEX II concept streetLighting.</rdfs:comment>
        <rdfs:label>Street Lighting Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StreetLighting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Strike -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Strike">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation resulting from industrial action that could disrupt traffic. This concept and description are from the DATEX II concept strike.</rdfs:comment>
        <rdfs:label>Strike</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Strike</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StrongGustsOfWind -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StrongGustsOfWind">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Constantly varying winds, strong at times. This concept and description are from the DATEX II concept strongGustsOfWind.</rdfs:comment>
        <rdfs:label>Strong Gusts Of Wind</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StrongGustsOfWind</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#StrongWinds -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#StrongWinds">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Winds between 40 km/h and 60 km/h. This concept and description are from the DATEX II concept strongWinds.</rdfs:comment>
        <rdfs:label>Strong Winds</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#StrongWinds</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Subsidence -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Subsidence">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>The surface of some ransport infrastructure has sunken or collapsed in places. This concept and description are a generalised version of the DATEX II concept subsidence.</rdfs:comment>
        <rdfs:label>Subsidence</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Subsidence</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SurfaceWater -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SurfaceWater">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Water is resting on the roadway which provides an increased hazard to vehicles. This concept and description are from the DATEX II concept surfaceWater.</rdfs:comment>
        <rdfs:label>Surface Water</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SurfaceWater</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Survey -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Survey">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary operation established by authorities on or adjacent to the transport infrastructure for the purpose of gathering statistics or other traffic related information. This concept and description are a generalised version of the DATEX II concept survey.</rdfs:comment>
        <rdfs:label>Survey</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Survey</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SwarmsOfInsects -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SwarmsOfInsects">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Large numbers of insects which create a hazard through reduced visibility. This concept and description are adaptations of the DATEX II concept swarmsOfInsects.</rdfs:comment>
        <rdfs:label>Swarms Of Insects</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SwarmsOfInsects</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#SweepingOfRoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#SweepingOfRoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Sweeping of the roadway. This concept and description are from the DATEX II concept sweepingOfRoad.</rdfs:comment>
        <rdfs:label>Sweeping Of Road</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#SweepingOfRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TemperatureFalling -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TemperatureFalling">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>The temperature is falling significantly. This concept and description are from the DATEX II concept temperatureFalling.</rdfs:comment>
        <rdfs:label>Temperature Falling</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TemperatureFalling</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TemporaryTrafficLights -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TemporaryTrafficLights">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>Traffic is being controlled by temporary traffic lights (red-yellow-green or red-green). This concept and description are from the DATEX II concept temporaryTrafficLights.</rdfs:comment>
        <rdfs:label>Temporary Traffic Lights</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TemporaryTrafficLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TemporaryTrafficLightsFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TemporaryTrafficLightsFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of a set of temporary traffic lights (red-yellow-green or red-green). This concept and description are based on the DATEX II concept temporaryTrafficLights.</rdfs:comment>
        <rdfs:label>Temporary Traffic Lights Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TemporaryTrafficLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TemporaryTrafficLightsFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TemporaryTrafficLightsFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning temporary traffic lights (red-yellow-green or red-green). This concept and description are based on the DATEX II concept temporaryTrafficLights.</rdfs:comment>
        <rdfs:label>Temporary Traffic Lights Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TemporaryTrafficLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TennisTournament -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TennisTournament">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Tennis tournament that could disrupt traffic. This concept and description are from the DATEX II concept tennisTournament.</rdfs:comment>
        <rdfs:label>Tennis Tournament</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TennisTournament</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TerroristIncident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TerroristIncident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation related to a perceived or actual threat of terrorism, which could disrupt traffic. This concept and description are from the DATEX II concept terroristIncident.</rdfs:comment>
        <rdfs:label>Terrorist Incident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TerroristIncident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Theft -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Theft">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where assets of one or more persons or authorities have been stolen. This concept and description are from the DATEX II concept theft.</rdfs:comment>
        <rdfs:label>Theft</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Theft</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Thunderstorms -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Thunderstorms">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Electrical storms, generally with heavy rain. This concept and description are from the DATEX II concept thunderstorms.</rdfs:comment>
        <rdfs:label>Thunderstorms</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Thunderstorms</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TidalFlowLaneInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TidalFlowLaneInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Dedicated tidal flow lane(s) are in operation in the specified direction. This concept and description are from the DATEX II concept tidalFlowLaneInOperation.</rdfs:comment>
        <rdfs:label>Tidal Flow Lane In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TidalFlowLaneInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TollGatesFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TollGatesFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of toll gates. This concept and description are based on the DATEX II concept tollGates.</rdfs:comment>
        <rdfs:label>Toll Gates Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TollGates</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TollGatesFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TollGatesFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning toll gates. This concept and description are based on the DATEX II concept tollGates.</rdfs:comment>
        <rdfs:label>Toll Gates Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TollGates</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TollGatesOpen -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TollGatesOpen">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>Toll gates are open with no fee collection at the specified location. This concept and description are from the DATEX II concept tollGatesOpen.</rdfs:comment>
        <rdfs:label>Toll Gates Open</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TollGatesOpen</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Tornadoes -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Tornadoes">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Very violent, whirling windstorms affecting narrow strips of country. This concept and description are from the DATEX II concept tornadoes.</rdfs:comment>
        <rdfs:label>Tornadoes</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Tornadoes</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Tournament -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Tournament">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Sporting event or series of events of unspecified type lasting more than one day which could disrupt traffic. This concept and description are from the DATEX II concept tournament.</rdfs:comment>
        <rdfs:label>Tournament</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Tournament</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ToxicCloudAlert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ToxicCloudAlert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>An alert to a toxic release of gases and/or particulates into the environment which may endanger the public and hence may cause traffic disruption. This concept and description are from the DATEX II concept toxicCloudAlert.</rdfs:comment>
        <rdfs:label>Toxic Cloud Alert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ToxicCloudAlert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrackLayingVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrackLayingVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Track laying vehicles are in use which may cause traffic disruption. This concept and description are from the DATEX II concept trackLayingVehicle.</rdfs:comment>
        <rdfs:label>Track Laying Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrackLayingVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TradeFair -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TradeFair">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>A periodic (e.g. annual), often traditional, gathering for trade promotion, which could disrupt traffic. This concept and description are from the DATEX II concept tradeFair.</rdfs:comment>
        <rdfs:label>Trade Fair</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TradeFair</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficBeingManuallyDirected -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficBeingManuallyDirected">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>Traffic is being manually directed. This concept and description are from the DATEX II concept trafficBeingManuallyDirected.</rdfs:comment>
        <rdfs:label>Traffic Being Manually Directed</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficBeingManuallyDirected</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficElementEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficElementEvent">
        <rdfs:subClassOf rdf:resource="http://semanticweb.cs.vu.nl/2009/11/sem/EventType"/>
        <rdfs:comment>An event which is not planned by the network operator, which is affecting, or has the potential to affect traffic flow. This concept and description are from the DATEX II concept TrafficElement.</rdfs:comment>
        <rdfs:label>Traffic Element Event</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficElement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficHeld -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficHeld">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>Traffic in the specified direction is temporarily held up due to an unplanned event (e.g. for clearance of wreckage following an accident). This concept and description are from the DATEX II concept trafficHeld.</rdfs:comment>
        <rdfs:label>Traffic Held</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficHeld</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficLightSetFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficLightSetFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of a set of traffic lights. This concept and description are based on the DATEX II concept trafficLightSets.</rdfs:comment>
        <rdfs:label>Traffic Light Set Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficLightSets</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficLightSetFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficLightSetFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning set of traffic lights. This concept and description are based on the DATEX II concept trafficLightSets.</rdfs:comment>
        <rdfs:label>Traffic Light Set Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficLightSets</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficSignalsFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficSignalsFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of traffic signals. This concept and description are based on the DATEX II concept trafficSignals.</rdfs:comment>
        <rdfs:label>Traffic Signals Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficSignals</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TrafficSignalsFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TrafficSignalsFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning traffic signals. This concept and description are based on the DATEX II concept trafficSignals.</rdfs:comment>
        <rdfs:label>Traffic Signals Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TrafficSignals</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TransportOfVip -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TransportOfVip">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>An operation to transport one or more VIPs. This concept and description are from the DATEX II concept transportOfVip.</rdfs:comment>
        <rdfs:label>Transport Of Vip</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TransportOfVip</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TreeAndVegetationCuttingWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TreeAndVegetationCuttingWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Tree and vegetation cutting work near transport infrastructure. This concept and description are a generalised version the DATEX II concept treeAndVegetationCuttingWork.</rdfs:comment>
        <rdfs:label>Tree And Vegetation Cutting Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TreeAndVegetationCuttingWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TunnelLightFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TunnelLightFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of tunnel lights. This concept and description are based on the DATEX II concept tunnelLights.</rdfs:comment>
        <rdfs:label>Tunnel Light Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TunnelLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TunnelLightFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TunnelLightFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning tunnel lights. This concept and description are based on the DATEX II concept tunnelLights.</rdfs:comment>
        <rdfs:label>Tunnel Lights Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TunnelLights</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TunnelVentilationFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TunnelVentilationFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of a tunnel ventilation system. This concept and description are based on the DATEX II concept tunnelVentilation.</rdfs:comment>
        <rdfs:label>Tunnel Ventilation Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TunnelVentilation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TunnelVentilationFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TunnelVentilationFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning tunnel ventilation system. This concept and description are based on the DATEX II concept tunnelVentilation.</rdfs:comment>
        <rdfs:label>Tunnel Ventilation Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TunnelVentilation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#TurnAroundInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#TurnAroundInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Traffic is being directed back down the opposite carriageway, possibly requiring the temporary removal of the central crash barrier. This concept and description are from the DATEX II concept turnAroundInOperation.</rdfs:comment>
        <rdfs:label>Turn Around In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#TurnAroundInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#UndefinedAuthorityActivity -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#UndefinedAuthorityActivity">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>An authority activity of undefined type. This concept and description are from the DATEX II concept undefinedAuthorityActivity.</rdfs:comment>
        <rdfs:label>Undefined Authority Activity</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#UndefinedAuthorityActivity</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Unknown -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Unknown">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>Driving conditions are unknown. This concept and description are from the DATEX II concept unknown.</rdfs:comment>
        <rdfs:label>Unknown</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Unknown</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#UnlitVehicleOnTheRoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#UnlitVehicleOnTheRoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Vehicles without lights are in use which may present a hazard to infrastructure users. This concept and description are a generalised version of the DATEX II concept unlitVehicleOnTheRoad.</rdfs:comment>
        <rdfs:label>Unlit Vehicle On The Road</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#UnlitVehicleOnTheRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#UnspecifiedAbnormalTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#UnspecifiedAbnormalTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AbnormalTraffic"/>
        <rdfs:comment>There are abnormal traffic conditions of an unspecified nature at the specified location. This concept and description are from the DATEX II concept unspecifiedAbnormalTraffic.</rdfs:comment>
        <rdfs:label>Unspecified Abnormal Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#UnspecifiedAbnormalTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#UnspecifiedAlert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#UnspecifiedAlert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>An alert to a perceived or actual threat of an unspecified nature, which could disrupt traffic. This concept and description are from the DATEX II concept unspecifiedAlert.</rdfs:comment>
        <rdfs:label>Unspecified Alert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#UnspecifiedAlert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#UseOfSpecifiedLanesOrCarriagewaysAllowed -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#UseOfSpecifiedLanesOrCarriagewaysAllowed">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>The specified lane(s) or carriageway(s) may be used. The normal lane(s) or carriageway(s) restrictions are not currently in force. This concept and description are from the DATEX II concept useOfSpecifiedLanesOrCarriagewaysAllowed.</rdfs:comment>
        <rdfs:label>Use Of Specified Lanes Or Carriageways Allowed</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#UseOfSpecifiedLanesOrCarriagewaysAllowed</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VariableMessageSignFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VariableMessageSignFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of a variable message sign. This concept and description are based on the DATEX II concept variableMessageSigns.</rdfs:comment>
        <rdfs:label>Variable Message Sign Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VariableMessageSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VariableMessageSignFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VariableMessageSignFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning variable message sign. This concept and description are based on the DATEX II concept variableMessageSigns.</rdfs:comment>
        <rdfs:label>Variable Message Sign Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VariableMessageSigns</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleCarryingHazardousMaterials -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleCarryingHazardousMaterials">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Vehicles carrying materials of a hazardous nature are present and these could expose others to additional hazards. This concept and description are a generalised version of the DATEX II concept vehicleCarryingHazardousMaterials.</rdfs:comment>
        <rdfs:label>Vehicle Carrying Hazardous Materials</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleCarryingHazardousMaterials</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleInDifficulty -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleInDifficulty">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A vehicle is experiencing difficulties (e.g. manoeuvring or propulsion difficulties) which may cause traffic disruption. This concept and description are from the DATEX II concept vehicleInDifficulty.</rdfs:comment>
        <rdfs:label>Vehicle In Difficulty</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleInDifficulty</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleInspectionCheckPoint -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleInspectionCheckPoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary operation established on or adjacent to the transport infrastructure for inspection of vehicles by authorities (e.g. vehicle safety checks and tachograph checks). This concept and description are a generalised version of the DATEX II concept vehicleInspectionCheckPoint.</rdfs:comment>
        <rdfs:label>Vehicle Inspection Check Point</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleInspectionCheckPoint</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleObstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleObstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Obstruction"/>
        <rdfs:comment>An obstruction on some infrastructure caused by one or more vehicles. This concept and description are a generalised version of the DATEX II concept VehicleObstruction.</rdfs:comment>
        <rdfs:label>Vehicle Obstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleObstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleOffInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleOffInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all accidents where one or more vehicles have left the transport infrastructure.</rdfs:comment>
        <rdfs:label>Vehicle Off Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleOffRoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleOffRoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleOffInfrastructure"/>
        <rdfs:comment>Includes all accidents where one or more vehicles have left the roadway. This concept and description are from the DATEX II concept vehicleOffRoad.</rdfs:comment>
        <rdfs:label>Vehicle Off Road</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleOffRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleOnFire -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleOnFire">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A vehicle is or has been on fire and may cause traffic disruption. This concept and description are from the DATEX II concept vehicleOnFire.</rdfs:comment>
        <rdfs:label>Vehicle On Fire</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleOnFire</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleOnWrongCarriageway -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleOnWrongCarriageway">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A vehicle is travelling the wrong way along a divided highway (i.e. on the wrong side). This concept and description are from the DATEX II concept vehicleOnWrongCarriageway.</rdfs:comment>
        <rdfs:label>Vehicle On Wrong Carriageway</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleOnWrongCarriageway</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleRecovery -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleRecovery">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Vehicle recovery. This concept and description are from the DATEX II concept vehicleRecovery.</rdfs:comment>
        <rdfs:label>Vehicle Recovery</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleRecovery</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleRepair -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleRepair">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Vehicle repair assistance. This concept and description are from the DATEX II concept vehicleRepair.</rdfs:comment>
        <rdfs:label>Vehicle Repair</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleRepair</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleSpunAround -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleSpunAround">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all accidents where a vehicle has skidded and has come to rest not facing its intended line of travel. This concept and description are from the DATEX II concept vehicleSpunAround.</rdfs:comment>
        <rdfs:label>Vehicle Spun Around</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleSpunAround</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleStorageInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleStorageInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Vehicles are being stored on the roadway and/or at a rest area or service area at the specified location. This concept and description are from the DATEX II concept vehicleStorageInOperation.</rdfs:comment>
        <rdfs:label>Vehicle Storage In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleStorageInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleStuck -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleStuck">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>One or more vehicles are stuck (i.e. unable to move). This concept and description are adaptations of the DATEX II concept vehicleStuck.</rdfs:comment>
        <rdfs:label>Vehicle Stuck</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleStuck</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleStuckUnderBridge -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleStuckUnderBridge">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleStuck"/>
        <rdfs:comment>A vehicle is stuck under a bridge. This concept and description are from the DATEX II concept vehicleStuckUnderBridge.</rdfs:comment>
        <rdfs:label>Vehicle Stuck Under Bridge</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleStuckUnderBridge</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleWeighing -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleWeighing">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary operation established on or adjacent to the transport infrastructure for weighing of vehicles by authorities. This concept and description are a generalised version of the DATEX II concept vehicleWeighing.</rdfs:comment>
        <rdfs:label>Vehicle Weighing</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleWeighing</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleWithOverheightLoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleWithOverheightLoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>An over-height vehicle which may present a hazard to road users. This concept and description are from the DATEX II concept vehicleWithOverheightLoad.</rdfs:comment>
        <rdfs:label>Vehicle With Overheight Load</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleWithOverheightLoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VehicleWithOverwideLoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VehicleWithOverwideLoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>A vehicle of width greater than that normally allowed which may cause traffic disruption. This concept and description are from the DATEX II concept vehicleWithOverwideLoad.</rdfs:comment>
        <rdfs:label>Vehicle With Overwide Load</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VehicleWithOverwideLoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VeryHazardous -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VeryHazardous">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>Driving conditions are very hazardous due to environmental conditions. This concept and description are from the DATEX II concept veryHazardous.</rdfs:comment>
        <rdfs:label>Very Hazardous</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VeryHazardous</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VeryStrongGustsOfWind -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VeryStrongGustsOfWind">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Constantly varying winds, very strong at times. This concept and description are from the DATEX II concept veryStrongGustsOfWind.</rdfs:comment>
        <rdfs:label>Very Strong Gusts Of Wind</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VeryStrongGustsOfWind</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#VisibilityReduced -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#VisibilityReduced">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Environmental conditions causing reduced visibility. This concept and description are from the DATEX II concept visibilityReduced.</rdfs:comment>
        <rdfs:label>Visibility Reduced</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#VisibilityReduced</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WaterSportsMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WaterSportsMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Water sports meeting that could disrupt traffic. This concept and description are from the DATEX II concept waterSportsMeeting.</rdfs:comment>
        <rdfs:label>Water Sports Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WaterSportsMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WeakBridge -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WeakBridge">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Weak bridge capable of carrying a reduced load, typically with a reduced weight limit restriction imposed. This concept and description are from the DATEX II concept weakBridge.</rdfs:comment>
        <rdfs:label>Weak Bridge</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WeakBridge</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WeatherRelatedConditions -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WeatherRelatedConditions">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Conditions"/>
        <rdfs:comment>Conditions of infrastructure, for example road surfaces, that are related to the weather which may affect the transport conditions, such as ice, snow or water. This concept and description are a generalised version of the DATEX II concept WeatherRelatedRoadConditions.</rdfs:comment>
        <rdfs:label>Weather Related Road Conditions</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WeatherRelatedRoadConditions</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WeighInMotion -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WeighInMotion">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary facility established by authorities on the carriageway for weighing vehicles while in motion. This concept and description are from the DATEX II concept weighInMotion.</rdfs:comment>
        <rdfs:label>Weigh In Motion</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WeighInMotion</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WeightRestrictionInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WeightRestrictionInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>A weight restriction is in operation. This concept and description are from the DATEX II concept weightRestrictionInOperation.</rdfs:comment>
        <rdfs:label>Weight Restriction In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WeightRestrictionInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Wet -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Wet">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Road surface is wet. This concept and description are from the DATEX II concept wet.</rdfs:comment>
        <rdfs:label>Wet</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Wet</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WetAndIcyRoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WetAndIcyRoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Increased skid risk due to partly thawed, wet road with packed snow and ice, or rain falling on packed snow and ice. This concept and description are from the DATEX II concept wetAndIcyRoad.</rdfs:comment>
        <rdfs:label>Wet And Icy Road</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WetAndIcyRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WetIcyPavement -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WetIcyPavement">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Partly thawed, wet pedestrian pavement with packed snow and ice, or rain falling on packed snow and ice. This concept and description are from the DATEX II concept wetIcyPavement.</rdfs:comment>
        <rdfs:label>Wet Icy Pavement</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WetIcyPavement</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WhiteOut -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WhiteOut">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Falling snow in blizzard conditions resulting in very reduced visibility. This concept and description are from the DATEX II concept whiteOut.</rdfs:comment>
        <rdfs:label>White Out</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WhiteOut</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WinterConditions -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WinterConditions">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DrivingCondition"/>
        <rdfs:comment>Driving conditions are consistent with those expected in winter. This concept and description are from the DATEX II concept winterConditions.</rdfs:comment>
        <rdfs:label>Winter Conditions</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WinterConditions</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WinterSportsMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WinterSportsMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Winter sports meeting or event (e.g. skiing, ski jumping, skating) that could disrupt traffic. This concept and description are from the DATEX II concept winterSportsMeeting.</rdfs:comment>
        <rdfs:label>Winter Sports Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WinterSportsMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#WinterStorm -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#WinterStorm">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Heavy rain, sleet, hail and/or snow in combination with strong winds, limiting visibility to 50m or less. This concept and description are from the DATEX II concept winterStorm.</rdfs:comment>
        <rdfs:label>Winter Storm</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#WinterStorm</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://semanticweb.cs.vu.nl/2009/11/sem/Event -->

    <owl:Class rdf:about="http://semanticweb.cs.vu.nl/2009/11/sem/Event"/>
    


    <!-- http://semanticweb.cs.vu.nl/2009/11/sem/EventType -->

    <owl:Class rdf:about="http://semanticweb.cs.vu.nl/2009/11/sem/EventType"/>
    


    <!-- http://xmlns.com/foaf/0.1/Agent -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
    


