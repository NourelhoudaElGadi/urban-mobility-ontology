    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ControlledAvalanche">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Controlled avalanche work. This concept and description are from the DATEX II concept controlledAvalanche.</rdfs:comment>
        <rdfs:label>Controlled Avalanche</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ControlledAvalanche</rdfs:seeAlso>
    </owl:Class>
    


