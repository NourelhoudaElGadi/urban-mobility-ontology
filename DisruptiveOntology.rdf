        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
        <rdfs:comment>Collision of vehicle with one or more animals. This concept and description are from the DATEX II concept collisionWithAnimal.</rdfs:comment>
        <rdfs:label>Collision With Animal</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CollisionWithAnimal</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CollisionWithObstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CollisionWithObstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Collision"/>
