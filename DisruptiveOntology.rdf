    <!-- http://purl.org/td/transportdisruption#causeOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/td/transportdisruption#causeOf">
        <owl:inverseOf rdf:resource="http://purl.org/td/transportdisruption#hasCause"/>
        <rdfs:comment>Indicates that a Disruptive Event is a cause of a Disruptive Impact.</rdfs:comment>
        <rdfs:label>cause of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/td/transportdisruption#hasCause -->

    <owl:ObjectProperty rdf:about="http://purl.org/td/transportdisruption#hasCause">
        <rdfs:domain rdf:resource="http://purl.org/td/transportdisruption#DisruptiveImpact"/>
        <rdfs:comment>Indicates that a Disruptive Impact is caused by an Event.</rdfs:comment>
        <rdfs:label>has cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/td/transportdisruption#hasPlan -->

    <owl:ObjectProperty rdf:about="http://purl.org/td/transportdisruption#hasPlan">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:range rdf:resource="http://purl.org/td/transportdisruption#Plan"/>
        <rdfs:comment>Indicates a Plan that a foaf:Agent has.</rdfs:comment>
        <rdfs:label>has plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/td/transportdisruption#impactsOn -->

    <owl:ObjectProperty rdf:about="http://purl.org/td/transportdisruption#impactsOn">
        <rdfs:domain rdf:resource="http://purl.org/td/transportdisruption#DisruptiveImpact"/>
        <rdfs:range rdf:resource="http://purl.org/td/transportdisruption#Plan"/>
        <rdfs:comment>Indicates a Plan that a Disruptive Impact affects.</rdfs:comment>
        <rdfs:label>impacts on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/td/transportdisruption#relevantTo -->

    <owl:ObjectProperty rdf:about="http://purl.org/td/transportdisruption#relevantTo">
        <rdfs:domain rdf:resource="http://purl.org/td/transportdisruption#DisruptiveImpact"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:label>Indicates a foaf:Agent that a Disruptive Impact is relevant to.</rdfs:label>
        <rdfs:label>relevant to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/td/transportdisruption#AbandonedVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AbandonedVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Abandoned vehicle(s) which may cause traffic disruption. This concept and description are a generalised version of the DATEX II concept abandonedVehicle.</rdfs:comment>
        <rdfs:label>Abandoned Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AbandonedVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AbnormalLoad -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AbnormalLoad">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Vehicle(s) carrying exceptional load(s) which may cause traffic disruption. This concept and description are from the DATEX II concept abnormalLoad.</rdfs:comment>
        <rdfs:label>Abnormal Load</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AbnormalLoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AbnormalTraffic -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AbnormalTraffic">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>A traffic condition which is not normal. This concept and description are from the DATEX II concept AbnormalTraffic.</rdfs:comment>
        <rdfs:label>Abnormal Traffic</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AbnormalTraffic</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Accident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Accident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>Accidents are situations in which one or more vehicles lose control and do not recover.  They include collisions between vehicle(s) or other network user(s), between vehicle(s) and fixed obstacle(s), or they result from a vehicle running off the network infrastructure. This concept and description are a generalised version of the DATEX II concept accident.</rdfs:comment>
        <rdfs:label>Accident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Accident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvestigationWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvestigationWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>An operation involving authorised investigation work connected to an earlier reported accident. This concept and description are from the DATEX II concept accidentInvestigationWork.</rdfs:comment>
        <rdfs:label>Accident Investigation Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvestigationWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingBicycles -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingBicycles">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one bicycle. This concept and description are from the DATEX II concept accidentInvolvingBicycles.</rdfs:comment>
        <rdfs:label>Accident Involving Bicycles</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingBicycles</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingBuses -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingBuses">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one passenger vehicle. This concept and description are from the DATEX II concept accidentInvolvingBuses.</rdfs:comment>
        <rdfs:label>Accident Involving Buses</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingBuses</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingHazardousMaterials -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingHazardousMaterials">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one vehicle believed to be carrying materials, which could present an additional hazard to others. This concept and description are a generalised version of the DATEX II concept accidentInvolvingHazardousMaterials.</rdfs:comment>
        <rdfs:label>Accident Involving Hazardous Materials</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingHazardousMaterials</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingHeavyLorries -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingHeavyLorries">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one heavy goods vehicle. This concept and description are from the DATEX II concept accidentInvolvingHeavyLorries.</rdfs:comment>
        <rdfs:label>Accident Involving Heavy Lorries</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingHeavyLorries</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingMassTransitVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingMassTransitVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one mass transit vehicle. This concept and description are from the DATEX II concept accidentInvolvingMassTransitVehicle.</rdfs:comment>
        <rdfs:label>Accident Involving Mass Transit Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingMassTransitVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingMopeds -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingMopeds">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one moped. This concept and description are from the DATEX II concept accidentInvolvingMopeds.</rdfs:comment>
        <rdfs:label>Accident Involving Mopeds</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingMopeds</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingMotorcycles -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingMotorcycles">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving at least one motorcycle. This concept and description are from the DATEX II concept accidentInvolvingMotorcycles.</rdfs:comment>
        <rdfs:label>Accident Involving Motorcycles</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingMotorcycles</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingObject -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingObject">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Accident"/>
        <rdfs:comment>Includes all accidents involving a vehicle or other type of object.</rdfs:comment>
        <rdfs:label>Accident Involving Object</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingRadioactiveMaterial -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingRadioactiveMaterial">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Accident involving radioactive material. This concept and description are from the DATEX II concept accidentInvolvingRadioactiveMaterial.</rdfs:comment>
        <rdfs:label>Accident Involving Radioactive Material</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingRadioactiveMaterial</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AccidentInvolvingTrain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AccidentInvolvingTrain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AccidentInvolvingObject"/>
        <rdfs:comment>Includes all accidents involving collision with a train. This concept and description are from the DATEX II concept accidentInvolvingTrain.</rdfs:comment>
        <rdfs:label>Accident Involving Train</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AccidentInvolvingTrain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ActiveSpeedControlInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ActiveSpeedControlInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#SpeedManagement"/>
        <rdfs:comment>Automatic speed control measures are in place at the specified location, whereby speed limits are set by an automatic system which is triggered by traffic sensing equipment. This concept and description are from the DATEX II concept activeSpeedControlInOperation.</rdfs:comment>
        <rdfs:label>Active Speed Control In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ActiveSpeedControlInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Activity -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Activity">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#TrafficElementEvent"/>
        <rdfs:comment>Deliberate human action external to the traffic stream or infrastructure which could disrupt traffic. This concept and description are an adaptation of the DATEX II concept Activity.</rdfs:comment>
        <rdfs:label>Activity</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Activity</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AdverseInfrastructureConditions -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AdverseInfrastructureConditions">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Conditions"/>
        <rdfs:comment>Types of road surface conditions which are not related to the weather. This concept and description are from the DATEX II concept NonWeatherRelatedRoadConditionTypeEnum.</rdfs:comment>
        <rdfs:label>Non Weather Related Road Condition Type Enum</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#NonWeatherRelatedRoadConditionTypeEnum</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AgriculturalShow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AgriculturalShow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Agricultural show or event which could disrupt traffic. This concept and description are from the DATEX II concept agriculturalShow.</rdfs:comment>
        <rdfs:label>Agricultural Show</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AgriculturalShow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AirAmbulance -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AirAmbulance">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureSideAssistance"/>
        <rdfs:comment>Air ambulance assistance. This concept and description are from the DATEX II concept airAmbulance.</rdfs:comment>
        <rdfs:label>Air Ambulance</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AirAmbulance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AirRaid -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AirRaid">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation relating to any threat from foreign air power. This concept and description are from the DATEX II concept airRaid.</rdfs:comment>
        <rdfs:label>Air Raid</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AirRaid</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AirShow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AirShow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Air show or other aeronautical event which could disrupt traffic. This concept and description are from the DATEX II concept airShow.</rdfs:comment>
        <rdfs:label>Air Show</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AirShow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AircraftOffInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AircraftOffInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleOffInfrastructure"/>
        <rdfs:comment>Includes all accidents where one or more aircraft have left the runway, taxiway, etc.</rdfs:comment>
        <rdfs:label>Aircraft Off Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AltercationOfVehicleOccupants -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AltercationOfVehicleOccupants">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>An altercation (argument, dispute or fight) between two or more vehicle occupants. This concept and description are from the DATEX II concept altercationOfVehicleOccupants.</rdfs:comment>
        <rdfs:label>Altercation Of Vehicle Occupants</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AltercationOfVehicleOccupants</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AnimalPresenceObstruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AnimalPresenceObstruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Obstruction"/>
        <rdfs:comment>An obstruction resulting from the presence of animals. This concept and description are a generalised version of the DATEX II concept AnimalPresenceObstruction.</rdfs:comment>
        <rdfs:label>Animal Presence Obstruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AnimalPresenceObstruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AnimalsOnTheInfrastructure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AnimalsOnTheInfrastructure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AnimalPresenceObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to animals on transport infrastructure. This concept and description are a generalised version of the DATEX II concept animalsOnTheRoad.</rdfs:comment>
        <rdfs:label>Animals On The Infrastructure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AnimalsOnTheRoad</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AnprCameraFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AnprCameraFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of automatic number plate recognition cameras. This concept and description are based on the DATEX II concept anprCameras.</rdfs:comment>
        <rdfs:label>Anpr Camera Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AnprCameras</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AnprCamerasFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AnprCamerasFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning automatic number plate recognition cameras. This concept and description are based on the DATEX II concept anprCameras.</rdfs:comment>
        <rdfs:label>Anpr Camera Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AnprCameras</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Assault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Assault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where an assault has taken place on one or more persons. This concept and description are from the DATEX II concept assault.</rdfs:comment>
        <rdfs:label>Assault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Assault</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AssetDestruction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AssetDestruction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where assets of one or more persons or authorities have been destroyed. This concept and description are from the DATEX II concept assetDestruction.</rdfs:comment>
        <rdfs:label>Asset Destruction</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AssetDestruction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AthleticsMeeting -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AthleticsMeeting">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Athletics event that could disrupt traffic. This concept and description are from the DATEX II concept athleticsMeeting.</rdfs:comment>
        <rdfs:label>Athletics Meeting</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AthleticsMeeting</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Attack -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Attack">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where an attack on a group of people or properties has taken place. This concept and description are from the DATEX II concept attack.</rdfs:comment>
        <rdfs:label>Attack</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Attack</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AttackOnVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AttackOnVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A situation where an attack on a vehicle or its occupants has taken place. This concept and description are from the DATEX II concept attackOnVehicle.</rdfs:comment>
        <rdfs:label>Attack On Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AttackOnVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AuthorityOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AuthorityOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#Activity"/>
        <rdfs:comment>Authority initiated operation or activity that could disrupt traffic. This concept and description are from the DATEX II concept AuthorityOperation.</rdfs:comment>
        <rdfs:label>Authority Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AuthorityOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AutomatedTollSystemFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AutomatedTollSystemFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of an automated toll system. This concept and description are based on the DATEX II concept automatedTollSystem.</rdfs:comment>
        <rdfs:label>Automated Toll System Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AutomatedTollSystem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#AutomatedTollSystemFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#AutomatedTollSystemFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning automated toll system. This concept and description are based on the DATEX II concept automatedTollSystem.</rdfs:comment>
        <rdfs:label>Automated Toll System Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#AutomatedTollSystem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Avalanches -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Avalanches">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalObstruction"/>
        <rdfs:comment>The transport infrastructure obstructed or partially obstructed due to snow slides. This concept and description are a generalised version of the DATEX II concept avalanches.</rdfs:comment>
        <rdfs:label>Avalanches</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Avalanches</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BadWeather -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BadWeather">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Adverse weather conditions are affecting the transport network. This concept and description are a generalised version of the DATEX II concept badWeather.</rdfs:comment>
        <rdfs:label>Bad Weather</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BadWeather</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BallGame -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BallGame">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Ball game event that could disrupt traffic. This concept and description are from the DATEX II concept ballGame.</rdfs:comment>
        <rdfs:label>Ball Game</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BallGame</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BaseballGame -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BaseballGame">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Baseball game event that could disrupt traffic. This concept and description are from the DATEX II concept baseballGame.</rdfs:comment>
        <rdfs:label>Baseball Game</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BaseballGame</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BasketballGame -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BasketballGame">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Basketball game event that could disrupt traffic. This concept and description are from the DATEX II concept basketballGame.</rdfs:comment>
        <rdfs:label>Basketball Game</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BasketballGame</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BicycleRace -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BicycleRace">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Bicycle race that could disrupt traffic. This concept and description are from the DATEX II concept bicycleRace.</rdfs:comment>
        <rdfs:label>Bicycle Race</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BicycleRace</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BlackIce -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BlackIce">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#WeatherRelatedConditions"/>
        <rdfs:comment>Black ice (i.e. clear ice, which is impossible or very difficult to see). This concept and description are adaptations the DATEX II concept blackIce.</rdfs:comment>
        <rdfs:label>Black Ice</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BlackIce</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BlastingWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BlastingWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureConstruction"/>
        <rdfs:comment>Blasting or quarrying work at the specified location. This concept and description are from the DATEX II concept blastingWork.</rdfs:comment>
        <rdfs:label>Blasting Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BlastingWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#Blizzard -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Blizzard">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Heavy snowfall in combination with strong winds, limiting visibility to 50m or less. This concept and description are from the DATEX II concept blizzard.</rdfs:comment>
        <rdfs:label>Blizzard</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Blizzard</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BlockadeOrBarrier -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BlockadeOrBarrier">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A manned blockade or barrier across a road stopping vehicles passing. This concept and description are from the DATEX II concept blockadeOrBarrier.</rdfs:comment>
        <rdfs:label>Blockade Or Barrier</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BlockadeOrBarrier</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BlowingDust -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BlowingDust">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Dust blowing causing significantly reduced visibility. This concept and description are a generalised version of the DATEX II concept blowingDust.</rdfs:comment>
        <rdfs:label>Blowing Dust</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BlowingDust</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BlowingSnow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BlowingSnow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#EnvironmentalConditions"/>
        <rdfs:comment>Fallen snow moving due to the forces of wind. This concept and description are from the DATEX II concept blowingSnow.</rdfs:comment>
        <rdfs:label>Blowing Snow</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BlowingSnow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BoatRace -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BoatRace">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Regatta (boat race event of sailing, powerboat or rowing) that could disrupt traffic. This concept and description are from the DATEX II concept boatRace.</rdfs:comment>
        <rdfs:label>Boat Race</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BoatRace</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BoatShow -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BoatShow">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Boat show which could disrupt traffic. This concept and description are from the DATEX II concept boatShow.</rdfs:comment>
        <rdfs:label>Boat Show</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BoatShow</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BombAlert -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BombAlert">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>An alert to a situation where suspected or actual explosive or incendiary devices may cause disruption to traffic. This concept and description are from the DATEX II concept bombAlert.</rdfs:comment>
        <rdfs:label>Bomb Alert</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BombAlert</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BombSquadInAction -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BombSquadInAction">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>An operation where a bomb squad is in action to deal with suspected or actual explosive or incendiary devices which may cause disruption to traffic. This concept and description are from the DATEX II concept bombSquadInAction.</rdfs:comment>
        <rdfs:label>Bomb Squad In Action</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BombSquadInAction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BoxingTournament -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BoxingTournament">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Boxing event that could disrupt traffic. This concept and description are from the DATEX II concept boxingTournament.</rdfs:comment>
        <rdfs:label>Boxing Tournament</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BoxingTournament</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BridgeSwingInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BridgeSwingInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#GeneralNetworkManagement"/>
        <rdfs:comment>The bridge at the specified location has swung or lifted and is therefore temporarily closed to traffic. This concept and description are from the DATEX II concept bridgeSwingInOperation.</rdfs:comment>
        <rdfs:label>Bridge Swing In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BridgeSwingInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BrokenDownBus -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BrokenDownBus">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#BrokenDownVehicle"/>
        <rdfs:comment>Broken down passenger vehicle(s) on the carriageway which may cause traffic disruption. This concept and description are from the DATEX II concept brokenDownBus.</rdfs:comment>
        <rdfs:label>Broken Down Bus</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BrokenDownBus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BrokenDownHeavyLorry -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BrokenDownHeavyLorry">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#BrokenDownVehicle"/>
        <rdfs:comment>Broken down heavy lorry/lorries on the carriageway which may cause traffic disruption. This concept and description are from the DATEX II concept brokenDownHeavyLorry.</rdfs:comment>
        <rdfs:label>Broken Down Heavy Lorry</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BrokenDownHeavyLorry</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BrokenDownTrain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BrokenDownTrain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#BrokenDownVehicle"/>
        <rdfs:comment>Broken down passenger vehicle(s) on the railway which may cause traffic disruption.</rdfs:comment>
        <rdfs:label>Broken Down Train</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BrokenDownVehicle -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BrokenDownVehicle">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#VehicleObstruction"/>
        <rdfs:comment>Broken down vehicle(s) which may cause traffic disruption. This concept and description are a generalised version of the DATEX II concept brokenDownVehicle.</rdfs:comment>
        <rdfs:label>Broken Down Vehicle</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BrokenDownVehicle</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BullFight -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BullFight">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Bull fighting event that could disrupt traffic. This concept and description are from the DATEX II concept bullFight.</rdfs:comment>
        <rdfs:label>Bull Fight</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BullFight</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BurstPipe -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BurstPipe">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>The infrastructure surface has sunken or collapsed in places due to burst pipes. This concept and description are a generalised version of the DATEX II concept burstPipe.</rdfs:comment>
        <rdfs:label>Burst Pipe</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BurstPipe</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#BurstWaterMain -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#BurstWaterMain">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Traffic may be disrupted due to local flooding and/or subsidence because of a broken water main. This concept and description are from the DATEX II concept burstWaterMain.</rdfs:comment>
        <rdfs:label>Burst Water Main</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#BurstWaterMain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CarPoolLaneInOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CarPoolLaneInOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Dedicated car pool lane(s) are in operation for vehicles carrying at least the specified number of occupants. This concept and description are from the DATEX II concept carPoolLaneInOperation.</rdfs:comment>
        <rdfs:label>Car Pool Lane In Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CarPoolLaneInOperation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CarriagewayClosures -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CarriagewayClosures">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>Carriageway closures are in operation at the specified location. This concept and description are from the DATEX II concept carriagewayClosures.</rdfs:comment>
        <rdfs:label>Carriageway Closures</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CarriagewayClosures</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CctvCamerasFailure -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CctvCamerasFailure">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Failure of closed-circuit television cameras. This concept and description are based on the DATEX II concept cctvCameras.</rdfs:comment>
        <rdfs:label>Cctv Camera Failure</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CctvCameras</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CctvCamerasFault -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CctvCamerasFault">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFault"/>
        <rdfs:comment>Faulty or malfunctioning closed-circuit television cameras. This concept and description are based on the DATEX II concept cctvCameras.</rdfs:comment>
        <rdfs:label>Cctv Camera Fault</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CctvCameras</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CeremonialEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CeremonialEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Formal or religious act, rite or ceremony that could disrupt traffic. This concept and description are from the DATEX II concept ceremonialEvent.</rdfs:comment>
        <rdfs:label>Ceremonial Event</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CeremonialEvent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ChemicalSpillageAccident -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ChemicalSpillageAccident">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#SpillageAccident"/>
        <rdfs:comment>Includes all situations resulting in a spillage of chemicals. This concept and description are a generalised version of the DATEX II concept chemicalSpillageAccident.</rdfs:comment>
        <rdfs:label>Chemical Spillage Accident</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ChemicalSpillageAccident</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CivilEmergency -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CivilEmergency">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A situation, perceived or actual, relating to a civil emergency which could disrupt traffic.  This includes large scale destruction, through events such as earthquakes, insurrection, and civil disobedience. This concept and description are from the DATEX II concept civilEmergency.</rdfs:comment>
        <rdfs:label>Civil Emergency</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CivilEmergency</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ClearanceWork -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ClearanceWork">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureMaintenance"/>
        <rdfs:comment>Clearance work of an unspecified nature. This concept and description are from the DATEX II concept clearanceWork.</rdfs:comment>
        <rdfs:label>Clearance Work</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ClearanceWork</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#ClosedPermanentlyForTheWinter -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#ClosedPermanentlyForTheWinter">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#RoadOrCarriagewayOrLaneManagement"/>
        <rdfs:comment>The road is closed to vehicles for the duration of the winter. This concept and description are adaptations of the DATEX II concept closedPermanentlyForTheWinter.</rdfs:comment>
        <rdfs:label>Closed Permanently For The Winter</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#ClosedPermanentlyForTheWinter</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CollapsedBridge -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CollapsedBridge">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>A bridge that has collapsed.</rdfs:comment>
        <rdfs:label>Collapsed Bridge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CollapsedSewer -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CollapsedSewer">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>The infrastructure surface has sunken or collapsed in places due to sewer failure. This concept and description are a generalised version of the DATEX II concept collapsedSewer.</rdfs:comment>
        <rdfs:label>Collapsed Sewer</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CollapsedSewer</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CollapsedTunnel -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CollapsedTunnel">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureFailure"/>
        <rdfs:comment>Collapse of a entire or section of a tunnel.</rdfs:comment>
        <rdfs:label>Collapsed Tunnel</rdfs:label>
    </owl:Class>
    


