    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DamagedTunnel">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to a tunnel that may cause traffic disruption. This concept and description are from the DATEX II concept damagedTunnel.</rdfs:comment>
        <rdfs:label>Damaged Tunnel</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedTunnel</rdfs:seeAlso>
