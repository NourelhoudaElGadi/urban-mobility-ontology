    <owl:Class rdf:about="http://purl.org/td/transportdisruption#Crowd">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#DisturbanceActivity"/>
        <rdfs:comment>A major gathering of people that could disrupt traffic. This concept and description are from the DATEX II concept crowd.</rdfs:comment>
        <rdfs:label>Crowd</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#Crowd</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CulturalEvent -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CulturalEvent">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#PublicEvent"/>
        <rdfs:comment>Cultural event which could disrupt traffic. This concept and description are from the DATEX II concept culturalEvent.</rdfs:comment>
        <rdfs:label>Cultural Event</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CulturalEvent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#CustomsOperation -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#CustomsOperation">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#AuthorityOperation"/>
        <rdfs:comment>A permanent or temporary operation established by customs and excise authorities withi, on or adjacent to transport infrastructure. This concept and description are a generalised version of the DATEX II concept customsOperation.</rdfs:comment>
        <rdfs:label>Customs Operation</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#CustomsOperation</rdfs:seeAlso>
    </owl:Class>
    


