        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to an elevated section of the carriageway over another carriageway that may cause traffic disruption. This concept and description are from the DATEX II concept damagedFlyover.</rdfs:comment>
        <rdfs:label>Damaged Flyover</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedFlyover</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DamagedGallery -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DamagedGallery">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to a gallery that may cause traffic disruption. This concept and description are from the DATEX II concept damagedGallery.</rdfs:comment>
        <rdfs:label>Damaged Gallery</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedGallery</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DamagedGantry -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DamagedGantry">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to a gantry above the infrastructure that may cause traffic disruption. This concept and description are a generalised version of the DATEX II concept damagedGantry.</rdfs:comment>
        <rdfs:label>Damaged Gantry</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedGantry</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/td/transportdisruption#DamagedRoadSurface -->

    <owl:Class rdf:about="http://purl.org/td/transportdisruption#DamagedRoadSurface">
        <rdfs:subClassOf rdf:resource="http://purl.org/td/transportdisruption#InfrastructureDamageObstruction"/>
        <rdfs:comment>Damage to the road surface that may cause traffic disruption. This concept and description are from the DATEX II concept damagedRoadSurface.</rdfs:comment>
        <rdfs:label>Damaged Road Surface</rdfs:label>
        <rdfs:seeAlso>http://datex2.eu/schema/2/2_0#DamagedRoadSurface</rdfs:seeAlso>
    </owl:Class>
    


