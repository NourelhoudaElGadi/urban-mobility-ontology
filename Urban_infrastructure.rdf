<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#"
     xml:base="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation"
     xmlns:geo="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:GTFS="http://www.semanticweb.org/hp/ontologies/2024/transport#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:Infrastructure="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#">
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#ehContains -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehContains">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#ehCoveredBy -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehCoveredBy">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#ehCovers -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehCovers">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#ehInside -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehInside">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#ehMeet -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehMeet">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#ehOverlap -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#ehOverlap">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#rcc8ec -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8ec">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#rcc8ntpp -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8ntpp">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#rcc8ntppi -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8ntppi">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#rcc8po -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8po">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#rcc8tpp -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8tpp">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#rcc8tppi -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#rcc8tppi">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfContains -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfContains">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfCrosses -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfCrosses">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfDisjoint -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfDisjoint">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfIntersects -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfIntersects">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfOverlaps -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfOverlaps">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfTouches -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfTouches">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfWithin -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfWithin">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Blocks -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Blocks">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Obstacles"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:comment>An obstacle blocks a street.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#EquippedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#EquippedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control"/>
        <rdfs:comment>An Road segment is equipped by a traffic control (sings or lights)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#HasIntersection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#HasIntersection">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Intersection"/>
        <rdfs:comment>A street has an intersection</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#HasSegments -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#HasSegments">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#IsPartOfStreet"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment"/>
        <rdfs:comment>A Street has Road Segment</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#IsPartOfNeighborhood -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#IsPartOfNeighborhood">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood"/>
        <rdfs:comment>A street is part of neighborhood</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#IsPartOfStreet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#IsPartOfStreet">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:comment>A road segment is a part of streets</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#LocatedOnStreet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#LocatedOnStreet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment"/>
        <rdfs:comment>A road markings is located on  a streets.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RondAboutEquippedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RondAboutEquippedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RondAbout"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control"/>
        <rdfs:comment>RondAbout Equipped by a traffic control</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RunsOnStreet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RunsOnStreet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:comment>shuttle run on a street</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#WalkOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#WalkOn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Pedestrians"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sidewalk"/>
        <rdfs:comment>Pedestrians walk on the sidewalk</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#adjacentMunicipalityTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#adjacentMunicipalityTo">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Municipalities"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Municipalities"/>
        <rdfs:comment>one municipality is adjacent to another municipality</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#adjacentNeighborhoodTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#adjacentNeighborhoodTo">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood"/>
        <rdfs:comment>one neighborhood is adjacent to another neighborhood</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#adjacentStreetTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#adjacentStreetTo">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:comment>one street is adjacent to another street</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#attached_to -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#attached_to">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Sidewalk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:comment>sidewalk attached to a street</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#connectedToIntersection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#connectedToIntersection">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_segment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Intersection"/>
        <rdfs:comment>Road segment is conected to intersection</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#frontsOnStreet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#frontsOnStreet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:comment>building fronts on the street</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasSensor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasSensor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Intersection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_sensor"/>
        <rdfs:comment>A intersection has a sensor</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasTrafficControl -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#hasTrafficControl">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Intersection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Traffic_control"/>
        <rdfs:comment>Intersection has a traffic control</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#isPartOfMunicipalities -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#isPartOfMunicipalities">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Municipalities"/>
        <rdfs:comment>neighborhood is part of municipalities</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#locatedInNeighborhood -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#locatedInNeighborhood">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Neighborhood"/>
        <rdfs:comment>different zone is located in a neighborhood</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#move_around -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#move_around">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#bicycle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bicycle_lane"/>
        <rdfs:comment>a bicycle move arond  the bicycle lane</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#parked_in -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#parked_in">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Parking"/>
        <rdfs:comment>a vehicle parked in a parking zone</rdfs:comment>
    </owl:ObjectProperty>
    


