    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#longitudeEsp">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#CommercialArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>longitude coordinate point of the comercial area</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#longitudeSecteur -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#longitudeSecteur">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Industrial_Zone"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>longitude coordinate point of the industrial zone</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#maxSpeed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#maxSpeed">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>max speed allowed on a street</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#nbr_branches -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#nbr_branches">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#RondAbout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>number of branches for a roundabout</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#nomVehicule -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#nomVehicule">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#DRT_Shuttle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of vehicle</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#numberOfPedestrianCrossings -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#numberOfPedestrianCrossings">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>numbre of pedestrian crossing on the street</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#numberOfRoundabouts -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#numberOfRoundabouts">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>number of rondabout on the street</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#numberOfTurns -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#numberOfTurns">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Streets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>number of turns on the street</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#sinuosité -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#sinuosité">
