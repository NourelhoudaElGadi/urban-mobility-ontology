    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#SpatialObject -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#AreaOfInterest -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#AreaOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Meso"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A functional urban area of interest at meso level.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Arrow_markings -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Arrow_markings">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings"/>
        <rdfs:comment>Directional arrows painted on the road surface to indicate traffic flow and vehicle movements</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bicycle_lane -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bicycle_lane">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Road_markings"/>
        <rdfs:comment>A dedicated lane on the road surface for use by bicycles,marked with specific symbols or signs</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Building">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Micro"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Micro Level: A  structure situated within the streets.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bus -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Bus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>A transport vehicle that travels along a fixed route, used for public or private transit in specific areas</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#CampusArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#CampusArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#AreaOfInterest"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Cars -->

    <owl:Class rdf:about="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Cars">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#vehicle"/>
        <rdfs:comment>Motorized vehicles used primarily for personal transportation,  with four wheels.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hp/ontologies/2024/7/Modélisation#Charging_station -->

